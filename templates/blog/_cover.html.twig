{# Image de couverture ou visuel de remplacement aux couleurs du site. Paramètres : article, classes, eager #}
{% if article.couverture %}
    <img src="{{ vich_uploader_asset(article, 'couvertureFile') }}"
        alt="{{ article.couvertureAlt ?: '' }}"
        class="{{ classes|default('') }} object-cover"
        {% if eager|default(false) %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
{% else %}
    <div class="{{ classes|default('') }} relative overflow-hidden bg-linear-to-br from-sage to-sage-dark flex items-center justify-center" aria-hidden="true">
        <svg class="absolute -top-10 -right-10 opacity-20" width="160" height="160" viewBox="0 0 220 220" fill="none">
            <circle cx="110" cy="110" r="90" stroke="white" stroke-width="1"/>
            <circle cx="110" cy="110" r="55" stroke="white" stroke-width="1"/>
        </svg>
        <span class="font-heading font-medium text-white/80 text-sm">{{ article.category ? article.category.nom : 'Neblink' }}</span>
    </div>
{% endif %}
