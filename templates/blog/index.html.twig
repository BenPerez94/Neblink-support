{% extends 'base.html.twig' %}

{% set suffixePage = page > 1 ? ' - Page ' ~ page : '' %}

{% block title %}
    {%- if category -%}
        {{ category.nom }} - Blog Neblink{{ suffixePage }}
    {%- elseif tag -%}
        #{{ tag.nom }} - Blog Neblink{{ suffixePage }}
    {%- else -%}
        Blog - Conseils et actus informatique - Neblink{{ suffixePage }}
    {%- endif -%}
{% endblock %}

{% block meta_description %}
    {%- if category and category.description -%}
        {{ category.description }}
    {%- elseif category -%}
        Articles et conseils sur le thème « {{ category.nom }} » par Neblink, dépannage informatique et développement web.
    {%- else -%}
        Conseils pratiques et actualités informatiques : dépannage, sécurité, sites internet. Des articles clairs par Neblink.
    {%- endif -%}
{% endblock %}

{% block robots %}
    {% if tag or recherche %}<meta name="robots" content="noindex, follow">{% endif %}
{% endblock %}

{% block canonical %}https://www.neblink.fr{{ app.request.pathInfo }}{{ page > 1 and not recherche ? '?page=' ~ page }}{% endblock %}

{% block nav_light %}true{% endblock %}

{% block body %}

    {# ---------- EN-TÊTE ---------- #}
    <section class="relative overflow-hidden px-4 pt-12 pb-8 md:pt-16">
        <div class="relative max-w-2xl mx-auto text-center">
            {# Cercles décoratifs attachés au bloc du titre, comme sur la page Développement web #}
            <svg class="absolute -top-8 -right-16 md:-top-10 md:-right-28 opacity-40 pointer-events-none" width="220" height="220" viewBox="0 0 220 220" fill="none">
                <circle cx="110" cy="110" r="90" stroke="#c9d9d0" stroke-width="1"/>
                <circle cx="110" cy="110" r="55" stroke="#c9d9d0" stroke-width="1"/>
            </svg>

            <span class="inline-flex items-center gap-1.5 bg-sage-dark/10 rounded-full px-4 py-2 text-xs text-sage-dark font-medium mb-5">
                <i data-lucide="{{ tag ? 'tag' : 'newspaper' }}" class="w-4 h-4"></i>
                {% if category %}Catégorie{% elseif tag %}Tag{% else %}Blog{% endif %}
            </span>

            <h1 class="font-heading font-medium text-2xl md:text-3xl text-slate-800 leading-tight mb-4">
                {%- if category -%}
                    {{ category.nom }}
                {%- elseif tag -%}
                    Articles tagués #{{ tag.nom }}
                {%- else -%}
                    Conseils et actus informatique
                {%- endif -%}
            </h1>

            <p class="text-sm md:text-base text-slate-500 leading-relaxed">
                {%- if category and category.description -%}
                    {{ category.description }}
                {%- else -%}
                    Astuces pratiques, nouveautés et alertes de sécurité pour garder votre ordinateur et votre site en forme.
                {%- endif -%}
            </p>
        </div>
    </section>

    {# La recherche recharge uniquement le cadre des résultats, au fil de la frappe #}
    <div class="max-w-5xl mx-auto px-4 pb-16"
        data-controller="blog-search"
        data-blog-search-url-value="{{ path(route, baseParams) }}">

        {# ---------- FILTRES ---------- #}
        <div class="flex flex-col md:flex-row md:items-center md:justify-center gap-3 mb-10">
            <nav class="flex flex-wrap justify-center gap-2" aria-label="Catégories du blog">
                {% set paramsRecherche = recherche ? {q: recherche} : {} %}
                <a href="{{ path('blog_index', paramsRecherche) }}" data-blog-search-target="pill" data-base-url="{{ path('blog_index') }}"
                    class="shrink-0 text-sm rounded-full px-4 py-2 border transition {{ not category and not tag ? 'bg-sage-dark border-sage-dark text-white' : 'bg-white border-slate-200 text-slate-600 hover:border-sage-dark hover:text-sage-dark' }}">
                    Tous
                </a>
                {% for cat in categories %}
                    {% if compteParCategorie[cat.id] is defined %}
                        <a href="{{ path('blog_category', {slug: cat.slug}|merge(paramsRecherche)) }}" data-blog-search-target="pill" data-base-url="{{ path('blog_category', {slug: cat.slug}) }}"
                            class="shrink-0 text-sm rounded-full px-4 py-2 border transition {{ category and category.id == cat.id ? 'bg-sage-dark border-sage-dark text-white' : 'bg-white border-slate-200 text-slate-600 hover:border-sage-dark hover:text-sage-dark' }}">
                            {{ cat.nom }}
                        </a>
                    {% endif %}
                {% endfor %}
            </nav>

            <form method="get" action="{{ path(route, baseParams) }}" role="search"
                data-action="submit->blog-search#submit"
                class="flex items-center gap-2 bg-white border border-slate-200 rounded-full px-4 py-2 md:w-64 focus-within:border-sage-dark transition">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 shrink-0"></i>
                <label for="blog-recherche" class="sr-only">
                    {{ category ? 'Rechercher dans ' ~ category.nom : (tag ? 'Rechercher dans #' ~ tag.nom : 'Rechercher un article') }}
                </label>
                <input type="search" id="blog-recherche" name="q" value="{{ recherche }}" maxlength="100" autocomplete="off"
                    placeholder="{{ category ? 'Rechercher dans ' ~ category.nom ~ '…' : 'Rechercher…' }}"
                    data-blog-search-target="input" data-action="input->blog-search#queue"
                    class="w-full bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none [&::-webkit-search-cancel-button]:cursor-pointer">
            </form>
        </div>

        {# target="_top" : les liens des cartes et de la pagination ouvrent une vraie page #}
        <turbo-frame id="blog-resultats" target="_top" class="block"
            data-blog-search-target="frame"
            data-action="turbo:before-frame-render->blog-search#beforeRender">
            {% include 'blog/_resultats.html.twig' %}
        </turbo-frame>
    </div>

{% endblock %}
