<a href="{{ path('blog_show', {slug: article.slug}) }}" class="group flex flex-col bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg hover:shadow-slate-900/5 transition">
    <div class="h-44 overflow-hidden">
        {% include 'blog/_cover.html.twig' with {article: article, classes: 'w-full h-full group-hover:scale-105 transition duration-300'} only %}
    </div>
    <div class="flex flex-col flex-1 p-5">
        <p class="text-xs text-slate-400 mb-2">
            {% if article.category %}<span class="text-sage-dark font-medium">{{ article.category.nom }}</span> · {% endif %}{{ article.tempsLecture }} min
        </p>
        <h3 class="font-heading font-medium text-base text-slate-800 leading-snug mb-2 group-hover:text-sage-dark transition">{{ article.titre|typo|surligner(recherche|default(null)) }}</h3>
        {% if article.extrait %}
            <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-4">{{ article.extrait|typo|surligner(recherche|default(null)) }}</p>
        {% endif %}
        <p class="mt-auto text-xs text-slate-400">{{ article.datePublication|date_fr }}</p>
    </div>
</a>
