{% extends 'base.html.twig' %}

{% set urlArticle = 'https://www.neblink.fr' ~ path('blog_show', {slug: article.slug}) %}
{% set description = article.metaDescription ?: article.extrait ?: 'Un article du blog Neblink : conseils et actus informatique.' %}
{% set imageArticle = article.couverture ? absolute_url(vich_uploader_asset(article, 'couvertureFile')) : absolute_url(asset('images/og-image.jpg')) %}
{% set aCouverture = article.couverture is not empty %}

{% block title %}{{ article.metaTitre ?: article.titre ~ ' - Blog Neblink' }}{% endblock %}
{% block meta_description %}{{ description }}{% endblock %}
{% block og_title %}{{ article.metaTitre ?: article.titre }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block og_image %}
    <meta property="og:image" content="{{ imageArticle }}">
    <meta name="twitter:image" content="{{ imageArticle }}">
    {% if article.couvertureAlt %}<meta property="og:image:alt" content="{{ article.couvertureAlt }}">{% endif %}
    {% if article.datePublication %}<meta property="article:published_time" content="{{ article.datePublication|date('c') }}">{% endif %}
    <meta property="article:modified_time" content="{{ article.updatedAt|date('c') }}">
    {% if article.category %}<meta property="article:section" content="{{ article.category.nom }}">{% endif %}
    {% for tag in article.tags %}<meta property="article:tag" content="{{ tag.nom }}">{% endfor %}
{% endblock %}

{% block robots %}
    {% if not estPublic %}<meta name="robots" content="noindex, nofollow">{% endif %}
{% endblock %}

{% block structured_data %}
    {% set fil = [
        {'@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.neblink.fr/'},
        {'@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.neblink.fr' ~ path('blog_index')},
    ] %}
    {% if article.category %}
        {% set fil = fil|merge([{'@type': 'ListItem', position: 3, name: article.category.nom, item: 'https://www.neblink.fr' ~ path('blog_category', {slug: article.category.slug})}]) %}
    {% endif %}
    {% set fil = fil|merge([{'@type': 'ListItem', position: fil|length + 1, name: article.titre}]) %}
    <script type="application/ld+json">
        {{ [
            {
                '@context': 'https://schema.org',
                '@type': 'BlogPosting',
                headline: article.titre,
                description: description,
                image: imageArticle,
                datePublished: article.datePublication ? article.datePublication|date('c') : null,
                dateModified: article.updatedAt|date('c'),
                inLanguage: 'fr-FR',
                mainEntityOfPage: urlArticle,
                articleSection: article.category ? article.category.nom : null,
                keywords: article.tags|map(t => t.nom)|join(', '),
                author: {'@type': 'Person', name: 'Benjamin Perez', url: 'https://www.neblink.fr' ~ path('app_about')},
                publisher: {'@type': 'Organization', name: 'Neblink', logo: {'@type': 'ImageObject', url: 'https://www.neblink.fr/android-chrome-512x512.png'}},
            }|filter(v => v is not null and v is not same as('')),
            {
                '@context': 'https://schema.org',
                '@type': 'BreadcrumbList',
                itemListElement: fil,
            }
        ]|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
    </script>
{% endblock %}

{% block nav_light %}false{% endblock %}

{% block body %}

    {# Barre de progression de lecture #}
    <div class="fixed top-0 inset-x-0 h-1 z-[60] pointer-events-none" aria-hidden="true">
        <div data-reading-progress class="h-full w-0 bg-sage-light"></div>
    </div>

    {# ---------- BANDEAU ---------- #}
    <section class="hero-section relative overflow-hidden -mt-24 pt-32 px-4 {{ aCouverture ? 'bg-sage-dark pb-14 md:pt-36 md:pb-24' : 'bg-linear-to-br from-sage-dark to-sage pb-12 md:pb-16' }}">
        {% if aCouverture %}
            {# Couverture fondue dans le bandeau : moitié droite sur ordinateur, fond voilé sur mobile #}
            <div class="absolute inset-y-0 right-0 w-full md:w-[58%]">
                {% include 'blog/_cover.html.twig' with {article: article, classes: 'w-full h-full', eager: true} only %}
                <div class="absolute inset-0 bg-sage-dark/85 md:bg-transparent md:bg-linear-to-r md:from-sage-dark md:via-sage-dark/50 md:to-sage-dark/5"></div>
            </div>
        {% else %}
            <svg class="absolute -top-16 -right-20 md:right-[8%] opacity-10 pointer-events-none" width="280" height="280" viewBox="0 0 220 220" fill="none">
                <circle cx="110" cy="110" r="90" stroke="white" stroke-width="1"/>
                <circle cx="110" cy="110" r="55" stroke="white" stroke-width="1"/>
            </svg>
        {% endif %}

        <div class="relative max-w-5xl mx-auto">
            <nav class="flex items-center gap-1.5 text-xs text-white/70 mb-5 flex-wrap" aria-label="Fil d'Ariane">
                <a href="{{ path('blog_index') }}" class="hover:text-white transition">Blog</a>
                {% if article.category %}
                    <i data-lucide="chevron-right" class="w-3 h-3 text-white/40"></i>
                    <a href="{{ path('blog_category', {slug: article.category.slug}) }}" class="hover:text-white transition">{{ article.category.nom }}</a>
                {% endif %}
            </nav>

            {% if article.category %}
                <a href="{{ path('blog_category', {slug: article.category.slug}) }}" class="inline-block bg-white/20 border border-white/30 rounded-full px-3 py-1 text-xs text-white mb-4 hover:bg-white/30 transition">{{ article.category.nom }}</a>
            {% endif %}

            <h1 class="font-heading font-medium text-2xl md:text-4xl text-white leading-tight mb-5 {{ aCouverture ? 'md:max-w-[50%]' : 'max-w-4xl' }}">{{ article.titre|typo }}</h1>

            <div class="flex items-center gap-3 text-sm text-white/80">
                <img src="{{ asset('images/profile.jpg') }}" alt="" class="w-8 h-8 rounded-full object-cover ring-2 ring-white/40">
                <p>
                    <span class="text-white">Benjamin Perez</span>
                    <span class="text-white/50 mx-1">·</span>
                    {% if article.datePublication %}<time datetime="{{ article.datePublication|date('Y-m-d') }}">{{ article.datePublication|date_fr }}</time>{% else %}Non daté{% endif %}
                    <span class="text-white/50 mx-1">·</span>
                    {{ article.tempsLecture }} min de lecture
                </p>
            </div>
        </div>
    </section>

    {# ---------- CONTENU + SIDEBAR ---------- #}
    <div class="relative max-w-5xl mx-auto px-4 mt-10 md:mt-12">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-10 lg:gap-14 items-start">

            <article data-article-body class="min-w-0">
                {% if article.sommaire|length > 1 %}
                    <details class="lg:hidden group bg-white border border-slate-200 rounded-2xl mb-8">
                        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none">
                            <span class="font-heading font-medium text-sm text-slate-800">Sommaire</span>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-open:rotate-180 transition"></i>
                        </summary>
                        <nav class="px-5 pb-4" aria-label="Sommaire">
                            {% for entree in article.sommaire %}
                                <a href="#{{ entree.id }}" class="block py-1.5 text-sm text-slate-500 hover:text-sage-dark {{ entree.niveau == 3 ? 'pl-4' }}">{{ entree.texte }}</a>
                            {% endfor %}
                        </nav>
                    </details>
                {% endif %}

                <div class="blog-content">
                    {{ article.contenu|raw }}
                </div>

                {% if article.tags is not empty %}
                    <div class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-slate-200">
                        {% for tag in article.tags %}
                            <a href="{{ path('blog_tag', {slug: tag.slug}) }}" class="text-xs text-slate-600 bg-white border border-slate-200 rounded-full px-3 py-1.5 hover:border-sage-dark hover:text-sage-dark transition">#{{ tag.nom }}</a>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="lg:hidden mt-8 flex flex-col gap-6">
                    <div class="flex items-center justify-between gap-4">
                        <p class="font-heading font-medium text-sm text-slate-800">Partager</p>
                        {% include 'blog/_share.html.twig' with {url: urlArticle, titre: article.titre} only %}
                    </div>
                    {% include 'blog/_cta.html.twig' %}
                </div>

                {# Emplacement prévu pour les commentaires (non activés pour l'instant) #}
                {% block comments %}{% endblock %}
            </article>

            {# ---------- SIDEBAR (desktop) ---------- #}
            <aside class="hidden lg:flex flex-col gap-5 sticky top-24">
                {% if article.sommaire|length > 1 %}
                    <div class="bg-white border border-slate-200 rounded-2xl p-5">
                        <p class="font-heading font-medium text-sm text-slate-800 mb-3">Sommaire</p>
                        <nav class="border-l border-slate-200 max-h-[45vh] overflow-y-auto" aria-label="Sommaire">
                            {% for entree in article.sommaire %}
                                <a href="#{{ entree.id }}" data-toc-link
                                    class="block -ml-px border-l-2 border-transparent py-1.5 text-sm leading-snug text-slate-500 hover:text-sage-dark transition {{ entree.niveau == 3 ? 'pl-6' : 'pl-3' }}">{{ entree.texte }}</a>
                            {% endfor %}
                        </nav>
                    </div>
                {% endif %}

                <div class="bg-white border border-slate-200 rounded-2xl p-5">
                    <p class="font-heading font-medium text-sm text-slate-800 mb-3">Partager</p>
                    {% include 'blog/_share.html.twig' with {url: urlArticle, titre: article.titre} only %}
                </div>

                {% include 'blog/_cta.html.twig' %}
            </aside>
        </div>
    </div>

    {# ---------- ARTICLES LIÉS ---------- #}
    {% if articlesLies is not empty %}
        <section class="max-w-5xl mx-auto px-4 mt-16 md:mt-20">
            <div class="flex items-end justify-between gap-4 mb-6">
                <h2 class="font-heading font-medium text-xl text-slate-800">À lire aussi</h2>
                <a href="{{ path('blog_index') }}" class="text-sm text-sage-dark font-medium hover:underline">Tous les articles</a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {% for lie in articlesLies %}
                    <div class="flex">{% include 'blog/_card.html.twig' with {article: lie} only %}</div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ---------- APERÇU ADMIN ---------- #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-slate-900/90 backdrop-blur text-white text-sm rounded-full pl-5 pr-2 py-2 shadow-xl whitespace-nowrap">
            {% if article.etat == 'brouillon' %}
                <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-slate-400"></span>Aperçu : brouillon non publié</span>
            {% elseif article.etat == 'programme' %}
                <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-amber-400"></span>Programmé le {{ article.datePublication|date('d/m/Y à H:i') }}</span>
            {% else %}
                <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400"></span>En ligne</span>
            {% endif %}
            <a href="{{ path('admin_blog_edit', {id: article.id}) }}" class="flex items-center gap-1.5 bg-white text-slate-800 rounded-full px-3 py-1.5 text-xs font-medium hover:bg-slate-100 transition">
                <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                Modifier
            </a>
        </div>
    {% endif %}

{% endblock %}
