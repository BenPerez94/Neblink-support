{# Contenu du cadre <turbo-frame id="blog-resultats"> : rechargé seul pendant la recherche #}

{# Sans résultat, le message vide plus bas suffit #}
{% if recherche and total > 0 %}
    <div class="flex flex-wrap items-center justify-between gap-2 mb-6" aria-live="polite">
        <p class="text-sm text-slate-500">
            <span class="font-medium text-slate-800">{{ total }} article{{ total > 1 ? 's' }}</span>
            pour « {{ recherche }} »{% if category %} dans {{ category.nom }}{% elseif tag %} dans #{{ tag.nom }}{% endif %}
        </p>
        <button type="button" data-action="blog-search#clear" class="flex items-center gap-1 text-xs text-slate-400 hover:text-sage-dark cursor-pointer transition">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
            Effacer la recherche
        </button>
    </div>
{% endif %}

{# ---------- ARTICLE À LA UNE ---------- #}
{% if aLaUne %}
    <a href="{{ path('blog_show', {slug: aLaUne.slug}) }}" data-animate="up"
        class="group grid grid-cols-1 md:grid-cols-[1.15fr_1fr] gap-6 md:gap-8 bg-white border border-slate-200 rounded-2xl p-3 md:p-4 mb-8 hover:shadow-lg hover:shadow-slate-900/5 transition">
        <div class="h-56 md:h-72 rounded-xl overflow-hidden">
            {% include 'blog/_cover.html.twig' with {article: aLaUne, classes: 'w-full h-full group-hover:scale-105 transition duration-300', eager: true} only %}
        </div>
        <div class="flex flex-col justify-center px-2 pb-3 md:px-0 md:pb-0 md:pr-6">
            <p class="text-xs mb-3">
                <span class="inline-flex items-center gap-1 bg-sage-dark/10 text-sage-dark font-medium rounded-full px-2.5 py-1">À la une</span>
                {% if aLaUne.category %}<span class="text-sage-dark font-medium ml-2">{{ aLaUne.category.nom }}</span>{% endif %}
            </p>
            <h2 class="font-heading font-medium text-xl md:text-2xl text-slate-800 leading-snug mb-3 group-hover:text-sage-dark transition">{{ aLaUne.titre|typo }}</h2>
            {% if aLaUne.extrait %}
                <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-4">{{ aLaUne.extrait|typo }}</p>
            {% endif %}
            <p class="text-xs text-slate-400">{{ aLaUne.datePublication|date_fr }} · {{ aLaUne.tempsLecture }} min de lecture</p>
        </div>
    </a>
{% endif %}

{# ---------- GRILLE ---------- #}
{% if articles|length > 0 %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {% for article in articles %}
            <div data-animate="up" class="flex">
                {% include 'blog/_card.html.twig' with {article: article, recherche: recherche} only %}
            </div>
        {% endfor %}
    </div>
{% elseif not aLaUne %}
    <div class="bg-white border border-slate-200 rounded-2xl text-center py-16 px-6" role="status">
        <i data-lucide="{{ recherche ? 'search' : 'newspaper' }}" class="w-8 h-8 text-sage-light mx-auto mb-3"></i>
        {% if recherche %}
            <p class="font-heading font-medium text-slate-700 mb-1">Aucun article ne correspond à « {{ recherche }} »</p>
            <p class="text-sm text-slate-400 mb-5">Essayez avec un autre mot{% if category or tag %} ou cherchez dans tout le blog{% endif %}.</p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <button type="button" data-action="blog-search#clear" class="text-sm text-sage-dark font-medium cursor-pointer hover:underline">Effacer la recherche</button>
                {% if category or tag %}
                    <a href="{{ path('blog_index', {q: recherche}) }}" class="text-sm text-sage-dark font-medium hover:underline">Chercher dans tout le blog</a>
                {% endif %}
            </div>
        {% else %}
            <p class="font-heading font-medium text-slate-700 mb-1">Les premiers articles arrivent bientôt</p>
            <p class="text-sm text-slate-400">En attendant, une question ? <a href="{{ path('app_contact') }}" class="text-sage-dark underline">Contactez-moi</a>.</p>
        {% endif %}
    </div>
{% endif %}

{# ---------- PAGINATION ---------- #}
{% if totalPages > 1 %}
    <nav class="flex items-center justify-center gap-2 mt-12" aria-label="Pagination">
        {% if page > 1 %}
            <a href="{{ path(route, page - 1 > 1 ? routeParams|merge({page: page - 1}) : routeParams) }}" rel="prev"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-slate-200 text-slate-600 hover:border-sage-dark hover:text-sage-dark transition" aria-label="Page précédente">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
            </a>
        {% endif %}
        {% for p in 1..totalPages %}
            {% if p == page %}
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-sage-dark text-white text-sm font-medium" aria-current="page">{{ p }}</span>
            {% else %}
                <a href="{{ path(route, p > 1 ? routeParams|merge({page: p}) : routeParams) }}"
                    class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-slate-200 text-sm text-slate-600 hover:border-sage-dark hover:text-sage-dark transition">{{ p }}</a>
            {% endif %}
        {% endfor %}
        {% if page < totalPages %}
            <a href="{{ path(route, routeParams|merge({page: page + 1})) }}" rel="next"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-white border border-slate-200 text-slate-600 hover:border-sage-dark hover:text-sage-dark transition" aria-label="Page suivante">
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        {% endif %}
    </nav>
{% endif %}
