{% extends 'base.html.twig' %}

{% block title %}Mon espace - Neblink{% endblock %}

{% block header_bg %}hidden{% endblock %}

{% block footer %}{% endblock %}

{% block body %}

    {% set statutBadges = {'en_attente': 'bg-amber-100 text-amber-700', 'en_cours': 'bg-blue-100 text-blue-700', 'termine': 'bg-green-100 text-green-700'} %}
    {% set statutGradient = {'en_attente': 'from-amber-500 to-amber-400', 'en_cours': 'from-blue-600 to-blue-400', 'termine': 'from-green-600 to-green-400'} %}
    {% set statutShadow = {'en_attente': 'shadow-amber-500/25', 'en_cours': 'shadow-blue-500/25', 'termine': 'shadow-green-500/25'} %}
    {% set statutBlur = {'en_attente': 'bg-amber-300', 'en_cours': 'bg-blue-300', 'termine': 'bg-green-300'} %}

    {# ---------- Barre supérieure ---------- #}
    <div class="sticky top-0 z-30 bg-[#faf9f6]/90 backdrop-blur-md border-b border-slate-200/70">
        <div class="max-w-3xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="flex items-center gap-2">
                <img src="{{ asset('images/logo.svg') }}" alt="Neblink" class="w-7 h-7">
                <span class="font-heading font-semibold text-sm text-slate-800">Neblink</span>
            </a>
            <div class="flex items-center gap-4">
                <a href="{{ path('app_home') }}" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-sage-dark transition">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Retour au site</span>
                </a>
                <form method="post" action="{{ path('espace_client_logout') }}">
                    <button type="submit" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-red-400 transition cursor-pointer">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Déconnexion</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <section class="px-4 py-8 md:py-12">
        <div class="max-w-3xl mx-auto">

            {# ---------- Héro d'accueil ---------- #}
            <div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-sage-dark via-sage to-sage-light p-6 md:p-8 mb-8 text-white shadow-lg shadow-sage-dark/15">
                <div class="absolute w-64 h-64 rounded-full bg-white/10 blur-3xl -top-20 -right-14"></div>
                <i data-lucide="folder-kanban" class="absolute -right-4 -bottom-6 w-32 h-32 text-white/[0.07]"></i>
                <div class="relative">
                    <p class="text-xs font-medium uppercase tracking-wide text-white/70 mb-2">Espace client</p>
                    <h1 class="font-heading font-semibold text-2xl md:text-3xl">Bonjour {{ client.nom }}</h1>
                    <p class="text-sm text-white/70 mt-2">Suivez ici l'avancement de vos projets et retrouvez vos documents.</p>
                </div>
            </div>

            {# ---------- Titre section ---------- #}
            <div class="flex items-center gap-2 mb-5">
                <i data-lucide="folder-kanban" class="w-4 h-4 text-sage-dark"></i>
                <p class="font-heading font-medium text-sm text-slate-500 uppercase tracking-wide">
                    Vos projets{% if projects is not empty %} ({{ projects|length }}){% endif %}
                </p>
            </div>

            {% if projects is empty %}
                <div class="flex flex-col items-center justify-center text-center py-20 bg-white border border-slate-200 rounded-3xl">
                    <div class="w-12 h-12 rounded-full bg-[#faf9f6] flex items-center justify-center mb-3">
                        <i data-lucide="folder-kanban" class="w-5 h-5 text-slate-300"></i>
                    </div>
                    <p class="text-base text-slate-400">Aucun projet pour le moment.</p>
                </div>
            {% else %}
                <div class="flex flex-col gap-5">
                    {% for project in projects %}
                        <div class="relative overflow-hidden bg-white border border-slate-100 rounded-3xl p-6 md:p-7 hover:shadow-xl hover:shadow-slate-900/5 hover:-translate-y-0.5 transition-all duration-200">
                            <div class="absolute w-40 h-40 rounded-full {{ statutBlur[project.statut] ?? 'bg-slate-200' }} blur-3xl opacity-20 -top-16 -right-16"></div>

                            <div class="relative flex items-start justify-between gap-3 mb-4">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-11 h-11 rounded-xl shrink-0 flex items-center justify-center bg-linear-to-br {{ statutGradient[project.statut] ?? 'from-slate-500 to-slate-400' }} shadow-md {{ statutShadow[project.statut] ?? 'shadow-slate-500/25' }}">
                                        <i data-lucide="folder-kanban" class="w-5 h-5 text-white"></i>
                                    </div>
                                    <p class="font-heading font-medium text-lg text-slate-800 truncate">{{ project.titre }}</p>
                                </div>
                                <span class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full {{ statutBadges[project.statut] ?? 'bg-slate-100 text-slate-600' }}">
                                    {{ project.statut|replace({'_': ' '})|capitalize }}
                                </span>
                            </div>

                            {% if project.description %}
                                <p class="relative text-base text-slate-500 leading-relaxed mb-5">{{ project.description }}</p>
                            {% endif %}

                            {% set topSteps = project.steps|filter(s => s.parent is null) %}
                            {% if topSteps is not empty %}
                                <div class="relative mb-5">
                                    <p class="flex items-center gap-1.5 text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">
                                        <span class="w-5 h-5 rounded-md bg-sage-dark/10 flex items-center justify-center">
                                            <i data-lucide="list-checks" class="w-3 h-3 text-sage-dark"></i>
                                        </span>
                                        Étapes
                                    </p>
                                    <div class="flex flex-col gap-3">
                                        {% for step in topSteps %}
                                            <div>
                                                <div class="flex items-center gap-2.5">
                                                    <div class="w-5 h-5 shrink-0 rounded-full flex items-center justify-center {{ step.termine ? 'bg-sage-dark' : 'bg-slate-200' }}">
                                                        {% if step.termine %}
                                                            <i data-lucide="check" class="w-3 h-3 text-white"></i>
                                                        {% endif %}
                                                    </div>
                                                    <span class="text-base {{ step.termine ? 'text-slate-700' : 'text-slate-400' }}">{{ step.titre }}</span>
                                                </div>
                                                {% if step.description %}
                                                    <p class="text-sm text-slate-400 mt-1 pl-7.5">{{ step.description }}</p>
                                                {% endif %}

                                                {% if step.children is not empty %}
                                                    <div class="flex flex-col gap-2 mt-2 pl-7.5">
                                                        {% for sub in step.children %}
                                                            <div>
                                                                <div class="flex items-center gap-2">
                                                                    <div class="w-4 h-4 shrink-0 rounded-full flex items-center justify-center {{ sub.termine ? 'bg-sage-dark' : 'bg-slate-200' }}">
                                                                        {% if sub.termine %}
                                                                            <i data-lucide="check" class="w-2.5 h-2.5 text-white"></i>
                                                                        {% endif %}
                                                                    </div>
                                                                    <span class="text-sm {{ sub.termine ? 'text-slate-600' : 'text-slate-400' }}">{{ sub.titre }}</span>
                                                                </div>
                                                                {% if sub.description %}
                                                                    <p class="text-xs text-slate-400 mt-0.5 pl-6.5">{{ sub.description }}</p>
                                                                {% endif %}
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            {% if project.documents is not empty %}
                                <div class="relative pt-4 border-t border-slate-100">
                                    <p class="flex items-center gap-1.5 text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">
                                        <span class="w-5 h-5 rounded-md bg-sage-dark/10 flex items-center justify-center">
                                            <i data-lucide="file-text" class="w-3 h-3 text-sage-dark"></i>
                                        </span>
                                        Documents
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        {% for document in project.documents %}
                                            <a href="{{ asset('uploads/documents/' ~ document.fichier) }}" target="_blank" class="flex items-center gap-1.5 text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 text-slate-600 hover:border-sage-dark hover:text-sage-dark transition">
                                                <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                                {{ document.nom }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>

{% endblock %}
