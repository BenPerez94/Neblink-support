{% extends 'base.html.twig' %}

{% block title %}Mon espace — Neblink{% endblock %}

{% block nav_light %}true{% endblock %}

{% block body %}

    <section class="px-4 py-16 md:py-20">
        <div class="max-w-3xl mx-auto">

            <div class="flex items-center justify-between mb-8">
                <div>
                    <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Espace client</p>
                    <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800">Bonjour {{ client.nom }}</h1>
                </div>
                <form method="post" action="{{ path('espace_client_logout') }}" class="inline">
                    <button type="submit" class="text-sm text-slate-500 hover:text-sage-dark cursor-pointer">Déconnexion</button>
                </form>
            </div>

            {% if projects is empty %}
                <p class="text-sm text-slate-400 text-center py-16">Aucun projet pour le moment.</p>
            {% else %}
                <div class="flex flex-col gap-4">
                    {% for project in projects %}
                        <div class="bg-white border border-slate-200 rounded-2xl p-6">
                            <div class="flex items-center justify-between gap-3 mb-3">
                                <p class="font-heading font-medium text-base text-slate-800">{{ project.titre }}</p>
                                <span class="text-[11px] font-medium px-2.5 py-1 rounded-full
                                    {{ project.statut == 'en_attente' ? 'bg-amber-100 text-amber-700' : '' }}
                                    {{ project.statut == 'en_cours' ? 'bg-blue-100 text-blue-700' : '' }}
                                    {{ project.statut == 'termine' ? 'bg-green-100 text-green-700' : '' }}">
                                    {{ project.statut|replace({'_': ' '})|capitalize }}
                                </span>
                            </div>

                            {% if project.description %}
                                <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ project.description }}</p>
                            {% endif %}

                            {% if project.steps is not empty %}
                                <div class="flex flex-col gap-2 mb-4">
                                    {% for step in project.steps %}
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-5 h-5 shrink-0 rounded-full flex items-center justify-center {{ step.termine ? 'bg-sage-dark' : 'bg-slate-200' }}">
                                                {% if step.termine %}
                                                    <i data-lucide="check" class="w-3 h-3 text-white"></i>
                                                {% endif %}
                                            </div>
                                            <span class="text-sm {{ step.termine ? 'text-slate-700' : 'text-slate-400' }}">{{ step.titre }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if project.documents is not empty %}
                                <div class="flex flex-wrap gap-2 pt-3 border-t border-slate-100">
                                    {% for document in project.documents %}
                                        <a href="{{ asset('uploads/documents/' ~ document.fichier) }}" target="_blank" class="flex items-center gap-1.5 text-xs bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 text-slate-600 hover:border-sage-dark transition">
                                            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                                            {{ document.nom }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>

{% endblock %}