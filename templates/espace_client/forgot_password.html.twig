{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Espace client Neblink{% endblock %}

{% block nav_light %}false{% endblock %}

{% block footer %}{% endblock %}

{% block header_bg %}hidden{% endblock %}

{% block body %}

    <section class="min-h-screen flex items-center justify-center px-4 bg-linear-to-br from-sage-dark via-sage to-sage-light">

        <div class="absolute w-72 h-72 rounded-full bg-white/10 blur-3xl -top-24 left-1/2 -translate-x-1/2"></div>

        <div class="relative w-full max-w-sm">

            <div class="flex justify-center mb-6">
                <img src="{{ asset('images/logo.svg') }}" alt="Neblink" class="w-12 h-12">
            </div>

            <div style="backdrop-filter: blur(10px);" class="bg-white/90 border border-white/40 rounded-3xl p-8 shadow-xl shadow-slate-900/10">

                <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1.5 text-center">Espace client</p>
                <h1 class="font-heading font-semibold text-xl text-slate-800 mb-2 text-center">Mot de passe oublié</h1>
                <p class="text-xs text-slate-400 text-center mb-6">On vous envoie un lien pour le réinitialiser</p>

                <form method="post">
                    <div class="mb-6">
                        <label for="email" class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Email</label>
                        <input type="email" name="email" id="email" required autofocus
                            class="w-full bg-[#faf9f6] rounded-xl px-4 py-3.5 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:bg-white transition border-l-[3px] border-l-sage-dark shadow-sm">
                    </div>

                    <button type="submit" class="w-full bg-linear-to-r from-sage-dark to-sage text-white font-heading font-semibold text-sm rounded-xl py-3.5 cursor-pointer hover:opacity-90 transition">
                        Envoyer le lien
                    </button>
                </form>

            </div>

            <p class="text-center text-white/70 text-xs mt-6">
                <a href="{{ path('espace_client_login') }}" class="hover:text-white transition">← Retour à la connexion</a>
            </p>

        </div>
    </section>

{% endblock %}