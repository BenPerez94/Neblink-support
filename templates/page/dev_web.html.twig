{% extends 'base.html.twig' %}

{% block title %}Développement web sur mesure — Neblink{% endblock %}
{% block meta_description %}Sites vitrines et applications web sur mesure avec Symfony et React. Du design à la mise en ligne.{% endblock %}

{% block nav_light %}true{% endblock %}

{% block body %}

    {# ---------- HERO ---------- #}
    <section class="relative overflow-hidden px-4 pt-16 pb-8 md:pt-24 md:pb-12">
        
        

        <div class="relative max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] gap-10 items-center ">

        <svg class="absolute -top-12 -right-18 md:-right-16 opacity-40 pointer-events-none" width="250" height="250" viewBox="0 0 220 220" fill="none">
            <circle cx="110" cy="110" r="90" stroke="#c9d9d0" stroke-width="1"/>
            <circle cx="110" cy="110" r="55" stroke="#c9d9d0" stroke-width="1"/>
        </svg>

            <div data-animate class="text-center md:text-left pr-6">
                <span class="inline-flex items-center gap-1.5 bg-sage-dark/10 rounded-full px-4 py-2 text-xs text-sage-dark font-medium mb-5">
                    <i data-lucide="code" class="w-4 h-4"></i>
                    Développement web sur mesure
                </span>

                <h1 class="font-heading font-medium text-2xl md:text-3xl text-slate-800 leading-tight mb-4">Des sites pensés pour convertir, pas juste pour exister</h1>

                <p class="text-sm md:text-base text-slate-500 leading-relaxed mb-7">Sites vitrines, applications sur mesure, refonte. Du design à la mise en ligne, en passant par le référencement.</p>

                <div class="flex flex-col md:flex-row gap-3 max-w-s mx-auto md:mx-0">
                    <a href="{{ path('app_contact') }}" class="bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-6 py-3.5 text-center">
                        Demander un devis
                    </a>
                    <a href="#portfolio" class="bg-white border border-slate-200 text-slate-700 font-medium text-sm rounded-xl px-6 py-3.5 text-center">
                        Réalisations
                    </a>
                </div>
            </div>

            <div data-animate="right" class="relative hidden md:block max-w-xs">
                <div class="bg-white border border-slate-200 rounded-2xl shadow-lg shadow-slate-900/5 overflow-hidden rotate-2">
                    <div class="flex gap-1.5 px-3 py-2 bg-slate-50 border-b border-slate-200">
                        <div class="w-1.5 h-1.5 rounded-full bg-red-300"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-amber-300"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-green-300"></div>
                    </div>
                    <div class="h-48 bg-linear-to-br from-sage to-sage-dark flex items-center justify-center">
                        <i data-lucide="layout-dashboard" class="w-9 h-9 text-white/85"></i>
                    </div>
                </div>
                <div class="absolute -bottom-4 -left-6 bg-white border border-slate-200 rounded-xl px-4 py-2.5 shadow-lg shadow-slate-900/5 flex items-center gap-2">
                    <i data-lucide="check" class="w-3.5 h-3.5 text-sage-dark"></i>
                    <span class="text-xs font-medium text-slate-800">Livré en 4 semaines</span>
                </div>
            </div>
        </div>

        <div data-animate class="relative max-w-3xl mx-auto grid grid-cols-3 divide-x divide-slate-200 border-t border-slate-200 mt-24 pt-6">
            <div class="text-center">
                <p class="font-heading font-semibold text-lg text-slate-800">Symfony</p>
                <p class="text-xs text-slate-400 mt-1">Back-end robuste</p>
            </div>
            <div class="text-center">
                <p class="font-heading font-semibold text-lg text-slate-800">React</p>
                <p class="text-xs text-slate-400 mt-1">Interfaces fluides</p>
            </div>
            <div class="text-center">
                <p class="font-heading font-semibold text-lg text-slate-800">Tailwind</p>
                <p class="text-xs text-slate-400 mt-1">Design soigné</p>
            </div>
        </div>
    </section>

    {# ---------- PORTFOLIO ---------- #}
    <section id="portfolio" class="px-4 py-16 md:py-24 bg-white">
        <div class="max-w-4xl mx-auto">
            <div class="text-center max-w-lg mx-auto mb-12">
                <p data-animate="down" class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">Réalisations</p>
                <h2 data-animate="up" class="font-heading font-semibold text-2xl md:text-3xl text-slate-800">Quelques projets récents</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div data-animate="up" class="bg-[#faf9f6] border border-slate-200 rounded-2xl overflow-hidden">
                    <div class="h-42 bg-linear-to-br from-sage to-sage-dark flex items-center justify-center">
                        <i data-lucide="shopping-cart" class="w-7 h-7 text-white/85"></i>
                    </div>
                    <div class="p-5">
                        <p class="font-heading font-medium text-sm text-slate-800 mb-1.5">Boutique en ligne locale</p>
                        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Site e-commerce avec gestion de stock et paiement en ligne.</p>
                        <span class="text-xs text-sage-dark font-medium">Symfony · Stripe</span>
                    </div>
                </div>

                <div data-animate="up" class="bg-[#faf9f6] border border-slate-200 rounded-2xl overflow-hidden">
                    <div class="h-42 bg-linear-to-br from-sage-light to-sage flex items-center justify-center">
                        <i data-lucide="calendar" class="w-7 h-7 text-white/85"></i>
                    </div>
                    <div class="p-5">
                        <p class="font-heading font-medium text-sm text-slate-800 mb-1.5">Réservation de prestations</p>
                        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Application de prise de rendez-vous en ligne pour un artisan.</p>
                        <span class="text-xs text-sage-dark font-medium">React · API</span>
                    </div>
                </div>

                <div data-animate="up" class="bg-[#faf9f6] border border-slate-200 rounded-2xl overflow-hidden">
                    <div class="h-42 bg-linear-to-br from-sage-dark to-[#2f5443] flex items-center justify-center">
                        <i data-lucide="store" class="w-7 h-7 text-white/85"></i>
                    </div>
                    <div class="p-5">
                        <p class="font-heading font-medium text-sm text-slate-800 mb-1.5">Vitrine restaurant</p>
                        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Site vitrine avec menu dynamique et formulaire de réservation.</p>
                        <span class="text-xs text-sage-dark font-medium">Twig · Tailwind</span>
                    </div>
                </div>

                <div data-animate class="border-2 border-dashed border-slate-200 rounded-2xl flex items-center justify-center min-h-45">
                    <div class="text-center px-4">
                        <i data-lucide="plus" class="w-6 h-6 text-slate-300 mx-auto mb-2"></i>
                        <p class="text-xs text-slate-400">Votre projet ici</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ---------- PROCESS + CTA ---------- #}
    <section class="px-4 pt-16 md:pt-24 bg-[#faf9f6]">
        <div class="max-w-4xl mx-auto">
            <div class="text-center max-w-lg mx-auto mb-12">
                <p data-animate="down" class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">Méthode</p>
                <h2 data-animate="up" class="font-heading font-semibold text-2xl md:text-3xl text-slate-800">Comment on travaille ensemble</h2>
            </div>

            <div data-animate class="relative flex flex-col md:grid md:grid-cols-4 gap-4 md:gap-x-4 max-w-3xl mx-auto mb-16">
                <div class="hidden md:block absolute top-5 left-[12%] right-[12%] h-px bg-slate-200"></div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">1</div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Découverte</p>
                        <p class="text-xs text-slate-400">Vos besoins, votre cible</p>
                    </div>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">2</div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Design</p>
                        <p class="text-xs text-slate-400">Maquette à valider</p>
                    </div>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">3</div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Développement</p>
                        <p class="text-xs text-slate-400">Code et tests</p>
                    </div>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">4</div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Mise en ligne</p>
                        <p class="text-xs text-slate-400">Livraison et suivi</p>
                    </div>
                </div>
            </div>

            <div data-animate="up" class="max-w-2xl mx-auto bg-linear-to-br from-sage-dark via-sage to-sage-light rounded-3xl p-8 md:p-10 text-center">
                <h2 class="font-heading font-semibold text-xl md:text-2xl text-white mb-2">Un projet en tête ?</h2>
                <p class="text-sm text-white/80 mb-6">Parlons-en autour d'un café ou d'un appel, sans engagement.</p>
                <a href="{{ path('app_contact') }}" class="inline-flex bg-white text-sage-dark font-heading font-medium text-sm rounded-xl px-7 py-3.5">
                    Demander un devis gratuit
                </a>
            </div>
        </div>
    </section>

{% endblock %}