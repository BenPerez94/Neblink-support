{% extends 'base.html.twig' %}

{% block title %}Contact — Neblink{% endblock %}

{% block nav_light %}true{% endblock %}

{% block body %}

    <section class="px-4 pt-16 pb-4  text-center">
        <div class="max-w-md mx-auto">
            <p data-animate="down" class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">Contact</p>
            <h1 data-animate="up" class="font-heading font-medium text-2xl md:text-3xl text-slate-800 mb-3 leading-snug">Un problème, une question, un projet ?</h1>
            <p data-animate="up" class="text-sm text-slate-500 leading-relaxed">Décrivez votre besoin, je vous réponds généralement sous quelques heures.</p>
        </div>
    </section>

    <section class="px-4 py-10 md:py-16">
        <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-8 items-start">

            <div data-animate="left" class="bg-white border border-slate-200 rounded-3xl p-6 md:p-10">
                <form method="post" action="#">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <input type="text" name="nom" placeholder="Nom" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-base text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-sage-dark transition">
                        <input type="tel" name="telephone" placeholder="Téléphone" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-base text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-sage-dark transition">
                    </div>

                    <select name="type_besoin" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-base text-slate-800 mb-4 focus:outline-none focus:border-sage-dark transition">
                        <option>Type de besoin</option>
                        <option>Dépannage</option>
                        <option>Développement web</option>
                        <option>Autre</option>
                    </select>

                    <textarea name="message" placeholder="Décrivez votre besoin" rows="6" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-base text-slate-800 placeholder:text-slate-400 mb-5 resize-none focus:outline-none focus:border-sage-dark transition"></textarea>

                    <button type="submit" class="w-full bg-sage-dark text-white font-heading font-medium text-base rounded-xl py-4">
                        Envoyer ma demande
                    </button>
                </form>
            </div>

            <div data-animate="right" class="flex flex-col gap-3">
                <div class="bg-white border border-slate-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="w-9 h-9 shrink-0 rounded-lg bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="phone" class="w-4 h-4 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Par téléphone</p>
                        <p class="text-xs text-slate-500">06 XX XX XX XX</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="w-9 h-9 shrink-0 rounded-lg bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="clock" class="w-4 h-4 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Disponibilité</p>
                        <p class="text-xs text-slate-500">Lun–Sam, 8h–19h</p>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-4 flex gap-3 items-start">
                    <div class="w-9 h-9 shrink-0 rounded-lg bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="map-pin" class="w-4 h-4 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-800">Zone d'intervention</p>
                        <p class="text-xs text-slate-500">Chaumont et 20km alentours</p>
                    </div>
                </div>

                <div class="bg-linear-to-br from-sage-dark to-sage rounded-2xl p-4">
                    <p class="text-sm font-medium text-white mb-1">Urgence ?</p>
                    <p class="text-xs text-white/80">Appelez directement, c'est souvent plus rapide.</p>
                </div>

                <div class="pt-4 text-center">
                    <p class="text-sm font-medium text-slate-800 mb-3">Réseaux sociaux</p>
                        <div class="flex justify-center gap-6">
                            <a href="https://facebook.com/tonpseudo" target="_blank" rel="noopener" class="w-10 h-10 rounded-lg bg-sage-dark/10 flex items-center justify-center hover:bg-sage-dark/20 transition">
                                <svg class="w-4 h-4 text-sage-dark" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            </a>
                            <a href="https://instagram.com/tonpseudo" target="_blank" rel="noopener" class="w-10 h-10 rounded-lg bg-sage-dark/10 flex items-center justify-center hover:bg-sage-dark/20 transition">
                                <svg class="w-4 h-4 text-sage-dark" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                                </svg>
                            </a>
                            <a href="https://linkedin.com/in/tonpseudo" target="_blank" rel="noopener" class="w-10 h-10 rounded-lg bg-sage-dark/10 flex items-center justify-center hover:bg-sage-dark/20 transition">
                            <svg class="w-4 h-4 text-sage-dark" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </section>

{% endblock %}