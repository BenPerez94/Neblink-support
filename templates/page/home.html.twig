{% extends 'base.html.twig' %}

{% block title %}Dépannage informatique à Chaumont, Neufchâteau et alentours - Neblink{% endblock %}
{% block meta_description %}Panne, virus, configuration... intervention à domicile près de Chaumont, Neufchâteau, ou à distance partout en France, sous 24h. Devis gratuit.{% endblock %}

{% block body %}

    {# ---------- HERO ---------- #}
    <section class="hero-section relative overflow-hidden 
     bg-linear-to-br from-sage-dark via-sage to-sage-light -mt-24 pt-32 px-4 pb-10 md:pb-12">

        {# Cercle décoratif flou #}
        <div class="absolute w-lg h-128 rounded-full bg-white/20 blur-2xl -top-40 left-1/2 -translate-x-1/2"></div>

    

        <div class="relative max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-15 items-center">
            {# Motifs géométriques - maintenant liés au container de contenu #}
            <svg class="absolute -top-6 -right-24 md:-right-20 opacity-10 pointer-events-none" width="250" height="250" viewBox="0 0 220 220" fill="none">
                <circle cx="110" cy="110" r="90" stroke="white" stroke-width="1"/>
                <circle cx="110" cy="110" r="55" stroke="white" stroke-width="1"/>
            </svg>


            {# Colonne texte #}
            <div data-animate class="text-center md:text-left pt-2 md:pt-10">
                <span class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full px-4 py-2 text-sm text-white mb-8 md:mt-12">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    Chaumont, Neufchâteau et alentours
                </span>

                <h1 class="font-heading font-medium text-3xl md:text-4xl text-white leading-tight mb-2">
                    Votre informatique,<br> entre de bonnes mains
                </h1>

                <p class="text-base md:text-xl font-extralight text-white/85 leading-relaxed mb-8">
                    Dépannage, configuration et conseil, chez vous ou à distance partout en France.
                </p>

                <div class="flex flex-col md:flex-row gap-4 max-w-sm mx-auto md:mx-0">
                    <a href="{{ path('app_contact') }}" class="bg-white text-sage-dark font-heading font-medium text-[14px] rounded-xl px-3 py-3 text-center">
                        Demander un dépannage
                    </a>
                    <a href="tel:+337444769" class="bg-white/15 backdrop-blur-md border border-white/35 text-white font-medium text-[14px] rounded-xl px-6 py-3 text-center inline-flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Appeler
                    </a>
                </div>
            </div>

            {# Colonne cartes en verre (desktop uniquement) #}
            <div  class="hidden md:block relative h-64">
                <div data-animate="down" class="absolute top-2 right-0 w-56 bg-white/15 backdrop-blur-md border border-white/30 rounded-2xl p-6 shadow-lg shadow-black/10">
                    <i data-lucide="wrench" class="w-5 h-5 text-white mb-2 display: inline-block" ></i>
                    <p class="text-s font-medium text-white mb-0.5">Dépannage express</p>
                    <p class="text-[12px] text-white/75">Sur place ou à distance</p>
                </div>

                <div data-animate="left" class="absolute top-28 left-12 w-56 bg-white/20 backdrop-blur-md border border-white/35 rounded-2xl p-6 shadow-lg shadow-black/10 
                ">
                    <i data-lucide="settings" class="w-5 h-5 text-white mb-2 display: inline-block"></i>
                    <p class="text-s font-medium text-white mb-0.5">Configuration</p>
                    <p class="text-[12px] text-white/75">PC, réseau, imprimante</p>
                </div>

                <div data-animate="up" class="absolute top-54 right-7 w-56 bg-white/15 backdrop-blur-md border border-white/30 rounded-2xl p-6 shadow-lg shadow-black/10">
                    <i data-lucide="lightbulb" class="w-5 h-5 text-white mb-2 display: inline-block"></i>
                    <p class="text-s font-medium text-white mb-0.5">Conseil</p>
                    <p class="text-[12px] text-white/75">Matériel, sécurité</p>
                </div>
            </div>

            {# Version mobile : cartes en ligne compacte #}
            <div class="md:hidden flex gap-2.5">
                <div class="flex-1 bg-white/15 backdrop-blur-md border border-white/30 rounded-xl p-3 text-center">
                    <i data-lucide="wrench" class="w-5 h-5 text-white mx-auto mb-1.5 display: inline-block"></i>
                    <p class="text-[10.5px] font-medium text-white">Dépannage</p>
                </div>
                <div class="flex-1 bg-white/15 backdrop-blur-md border border-white/30 rounded-xl p-3 text-center">
                    <i data-lucide="settings" class="w-5 h-5 text-white mx-auto mb-1.5"></i>
                    <p class="text-[10.5px] font-medium text-white">Config</p>
                </div>
                <div class="flex-1 bg-white/15 backdrop-blur-md border border-white/30 rounded-xl p-3 text-center">
                    <i data-lucide="lightbulb" class="w-5 h-5 text-white mx-auto mb-1.5 display: inline-block"></i>
                    <p class="text-[10.5px] font-medium text-white">Conseil</p>
                </div>
            </div>

        </div>

        {# Bandeau réassurance #}
        <div  data-animate class="relative max-w-4xl mx-auto mt-10 md:mt-24 flex flex-wrap justify-center gap-x-8 gap-y-2 pt-8 border-t border-white/20">
            <span class="text-sm text-white/85 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Devis gratuit
            </span>
            <span class="text-sm text-white/85 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Intervention sous 24h
            </span>
            <span class="text-sm text-white/85 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Particuliers et pros
            </span>
        </div>
    </section>

    {# ---------- SERVICES ---------- #}
    <section class="px-4 py-16 md:py-24 bg-[#faf9f6]">
        <div class="max-w-5xl mx-auto">

            <div class="text-center max-w-xl mx-auto mb-12">
                <p class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">Mes services</p>
                <h2 class="font-heading font-medium text-2xl md:text-3xl text-slate-800">Ce que je peux faire pour vous</h2>
                <p class="text-sm text-slate-500 leading-relaxed mt-6">Du dépannage express au conseil sur mesure, une solution pour chaque besoin.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div data-animate class="bg-white border border-slate-200 rounded-2xl p-6 flex gap-4 items-start shadow-sm">
                    <div class="w-11 h-11 shrink-0 rounded-xl bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="wrench" class="w-5 h-5 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="font-heading font-medium text-base text-slate-800 mb-1.5">Dépannage & réparation</p>
                        <p class="text-sm text-slate-500 leading-relaxed">Panne, virus, écran bleu... diagnostic et réparation sur place ou à distance.</p>
                    </div>
                </div>

                <div data-animate class="bg-white border border-slate-200 rounded-2xl p-6 flex gap-4 items-start shadow-sm">
                    <div class="w-11 h-11 shrink-0 rounded-xl bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="settings" class="w-5 h-5 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="font-heading font-medium text-base text-slate-800 mb-1.5">Installation & configuration</p>
                        <p class="text-sm text-slate-500 leading-relaxed">Nouveau PC, imprimante, réseau Wi-Fi, logiciels métier configurés pour vous.</p>
                    </div>
                </div>

                <div data-animate class="bg-white border border-slate-200 rounded-2xl p-6 flex gap-4 items-start shadow-sm">
                    <div class="w-11 h-11 shrink-0 rounded-xl bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="lightbulb" class="w-5 h-5 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="font-heading font-medium text-base text-slate-800 mb-1.5">Conseil & accompagnement</p>
                        <p class="text-sm text-slate-500 leading-relaxed">Choix de matériel, sécurité des données, organisation de votre informatique.</p>
                    </div>
                </div>

                <div data-animate class="bg-white border border-slate-200 rounded-2xl p-6 flex gap-4 items-start shadow-sm">
                    <div class="w-11 h-11 shrink-0 rounded-xl bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="refresh-cw" class="w-5 h-5 text-sage-dark"></i>
                    </div>
                    <div>
                        <p class="font-heading font-medium text-base text-slate-800 mb-1.5">Maintenance régulière</p>
                        <p class="text-sm text-slate-500 leading-relaxed">Un suivi pour les professionnels afin d'éviter les pannes avant qu'elles arrivent.</p>
                    </div>
                </div>

            </div>

            {# Bandeau transition vers dev web #}
            <div data-animate class="mt-6 bg-linear-to-br from-sage-dark via-sage to-sage-light rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
                <div>
                    <p class="font-heading font-medium text-base text-white mb-1">Vous avez aussi un projet de site web ?</p>
                    <p class="text-sm text-white/80">Découvrez mes services de développement web.</p>
                </div>
                <a href="{{ path('app_dev_web') }}" class="shrink-0 bg-white text-sage-dark rounded-lg px-5 py-2.5 text-sm font-medium font-heading inline-flex items-center gap-1.5">
                    Voir mes projets
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

        </div>
    </section>

    {# ---------- PROCESS + TARIFS ---------- #}
    <section class="px-4 py-16 md:py-24 bg-white">
        <div class="max-w-5xl mx-auto">

            {# Comment ça marche #}
            <div class="text-center max-w-lg mx-auto mb-12">
                <p data-animate="down" class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">Comment ça marche</p>
                <h2 data-animate="up" class="font-heading font-medium text-2xl md:text-3xl text-slate-800">Simple, rapide, sans surprise</h2>
            </div>

            <div data-animate class="relative flex flex-col md:grid md:grid-cols-4 gap-4 md:gap-x-4 max-w-3xl mx-auto mb-20">
                {# Ligne de connexion entre les étapes, desktop uniquement #}
                <div class="hidden md:block absolute top-5 left-[12%] right-[12%] h-px bg-slate-200"></div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">1</div>
                    <p class="text-sm text-slate-700">Vous décrivez le problème</p>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">2</div>
                    <p class="text-sm text-slate-700">Je propose créneau et devis</p>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">3</div>
                    <p class="text-sm text-slate-700">J'interviens chez vous ou à distance</p>
                </div>

                <div class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                    <div class="w-9 h-9 md:w-10 md:h-10 md:mx-auto md:mb-3 shrink-0 rounded-full bg-sage-dark text-white flex items-center justify-center font-heading font-medium text-sm">4</div>
                    <p class="text-sm text-slate-700">Vous validez, c'est réglé</p>
                </div>
            </div>

            {# Tarifs #}
            <div class="flex flex-col md:grid md:grid-cols-3 gap-3 md:gap-5 max-w-2xl mx-auto clip-x">
                <div data-animate="left" class="flex md:block items-center md:text-center justify-between border border-slate-200 rounded-2xl px-6 py-4 md:p-6 
                ">
                    <p class="text-sm text-slate-500 md:mb-2">Diagnostic</p>
                    <p class="font-heading font-semibold text-lg md:text-xl text-slate-800">Gratuit</p>
                </div>

                <div data-animate class="relative flex md:block items-center md:text-center justify-between border-2 border-sage-dark rounded-2xl px-6 py-4 md:p-6">
                    <span class="absolute -top-3 left-6 md:left-1/2 md:-translate-x-1/2 bg-sage-dark text-white text-[11px] font-medium px-3 py-1 rounded-full whitespace-nowrap">Populaire</span>
                    <p class="text-sm text-slate-500 md:mb-2">À distance</p>
                    <p class="font-heading font-semibold text-lg md:text-xl text-slate-800">dès 29€</p>
                </div>

                <div data-animate="right" class="flex md:block items-center md:text-center justify-between border border-slate-200 rounded-2xl px-6 py-4 md:p-6 ">
                    <p class="text-sm text-slate-500 md:mb-2">Sur place</p>
                    <p class="font-heading font-semibold text-lg md:text-xl text-slate-800">dès 49€</p>
                </div>
            </div>

            <p data-animate class="text-center text-sm text-slate-400 mt-6">Devis personnalisé pour les professionnels</p>

        </div>
    </section>

    {# ---------- À PROPOS + CONTACT ---------- #}
    <section class="px-4 pt-16 md:pt-24 bg-[#faf9f6]">
        <div class="max-w-3xl mx-auto">

            {# À propos + avis #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-6 md:mb-16 clip-x">
                <div>
                    <p data-animate="down" class="text-s font-medium text-sage-dark uppercase tracking-wide mb-6">À propos</p>
                    <h2 data-animate="left" class="font-heading font-medium text-xl md:text-2xl text-slate-800 mb-3 
                    ">Pourquoi me faire confiance</h2>
                    <p data-animate="left" class="text-sm text-slate-500 leading-relaxed">Basé entre Chaumont et Neufchâteau, j'aide particuliers et petites entreprises à résoudre leurs problèmes informatiques, sur place dans le secteur ou à distance partout en France. Pas de jargon compliqué, pas de vente forcée : juste une solution qui marche.</p>
                </div>

                <div data-animate="right" class="bg-white border border-slate-200 rounded-2xl p-5 mt-0 md:mt-12 ">
                    <div class="flex items-center gap-2 mb-3">
                        <i data-lucide="shield-check" class="w-5 h-5 text-sage-dark"></i>
                        <p class="font-heading font-medium text-sm text-slate-800">Mon engagement</p>
                    </div>
                    <ul class="space-y-2.5">
                        <li class="flex items-start gap-2 text-sm text-slate-600">
                            <i data-lucide="check" class="w-4 h-4 text-sage-dark shrink-0 mt-0.5"></i>
                            Devis clair avant toute intervention
                        </li>
                        <li class="flex items-start gap-2 text-sm text-slate-600">
                            <i data-lucide="check" class="w-4 h-4 text-sage-dark shrink-0 mt-0.5"></i>
                            Vous ne payez que si le problème est résolu
                        </li>
                        <li class="flex items-start gap-2 text-sm text-slate-600">
                            <i data-lucide="check" class="w-4 h-4 text-sage-dark shrink-0 mt-0.5"></i>
                            Aucune vente forcée de matériel ou service
                        </li>
                    </ul>
                </div>
            </div>

            {# Formulaire de contact #}
            <div data-animate="up" class="bg-white border border-slate-200 rounded-3xl p-8 max-w-lg mx-auto text-center ">
                <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1.5">Contact</p>
                <h2 class="font-heading font-semibold text-xl md:text-2xl text-slate-800 mb-3">Un problème informatique ?</h2>
                <p class="text-sm text-slate-500 mb-6">Décrivez-moi votre besoin, je vous réponds rapidement.</p>
                <a href="{{ path('app_contact') }}" class="inline-flex bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-8 py-3.5">
                    Me contacter
                </a>
            </div>

        </div>
    </section>
{% endblock %}