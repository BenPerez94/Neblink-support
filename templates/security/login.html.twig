{% extends 'base.html.twig' %}

{% block title %}Connexion admin — Neblink{% endblock %}

{% block nav_light %}false{% endblock %}

{% block footer %}{% endblock %}

{% block header_bg %}hidden{% endblock %}

{% block body %}

    <section class="min-h-screen   flex items-center justify-center px-4 bg-linear-to-br from-sage-dark via-sage to-sage-light">

        <div class="absolute w-72 h-72 rounded-full bg-white/10 blur-3xl -top-24 left-1/3"></div>

        <div class="relative w-full max-w-sm">


            <div style="backdrop-filter: blur(10px);" class="bg-white/90 border border-white/40 rounded-3xl p-8 shadow-xl shadow-slate-900/10">

                <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1.5 text-center">Espace admin</p>
                <h1 class="font-heading font-semibold text-xl text-slate-800 mb-6 text-center">Connexion</h1>

                {% if error %}
                    <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl px-4 py-3 mb-5">
                        Identifiants incorrects.
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-4">
                        <label for="username" class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Email</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus
                            class="w-full bg-[#faf9f6] rounded-xl px-4 py-3.5 text-base md:text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:bg-white transition border-l-[3px] border-l-sage-dark shadow-sm">
                    </div>

                    <div class="mb-6">
                        <label for="password" class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Mot de passe</label>
                        <div class="relative">
                            <input type="password" name="_password" id="password" autocomplete="current-password" required
                                class="w-full bg-[#faf9f6] rounded-xl px-4 py-3.5 pr-11 text-base md:text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:bg-white transition border-l-[3px] border-l-sage shadow-sm">
                            <button type="button" data-password-toggle tabindex="-1" aria-label="Afficher le mot de passe"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition cursor-pointer">
                                <i data-lucide="eye" class="w-4.5 h-4.5 password-toggle-icon-show"></i>
                                <i data-lucide="eye-off" class="w-4.5 h-4.5 password-toggle-icon-hide hidden"></i>
                            </button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="flex items-center justify-between mb-4">
                        <label for="remember_me" class="flex items-center gap-2 text-xs text-slate-500 cursor-pointer select-none">
                            <input type="checkbox" name="_remember_me" id="remember_me" value="on"
                                class="w-3.5 h-3.5 rounded border-slate-300 text-sage-dark focus:ring-sage-dark cursor-pointer">
                            Rester connecté
                        </label>
                        <a href="{{ path('app_forgot_password') }}" class="text-xs text-sage-dark hover:underline">Mot de passe oublié ?</a>
                    </div>

                    <button type="submit" class="w-full bg-linear-to-r from-sage-dark to-sage text-white font-heading font-semibold text-sm rounded-xl py-3.5 cursor-pointer hover:opacity-90 transition">
                        Se connecter
                    </button>
                </form>

            </div>

            <p class="text-center text-white/70 text-xs mt-6">
                <a href="{{ path('app_home') }}" class="hover:text-white transition">← Retour au site</a>
            </p>

        </div>
    </section>

{% endblock %}