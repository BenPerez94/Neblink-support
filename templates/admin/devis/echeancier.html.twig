{% extends 'admin/_layout.html.twig' %}

{% block title %}Échéancier {{ devis.numero }} - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Projets', path: path('admin_projects')},
        {label: project.titre, path: path('admin_project_show', {id: project.id})},
        {label: 'Échéancier'}
    ]) }}
{% endblock %}

{% macro row(index, libelle, montant, date) %}
    <div data-echeance-row class="grid grid-cols-1 sm:grid-cols-[1fr_9rem_10rem_auto] gap-2 items-center bg-[#faf9f6] rounded-2xl p-3">
        <input type="text" name="echeances[{{ index }}][libelle]" value="{{ libelle }}" placeholder="Libellé" data-echeance-libelle
            class="w-full text-base bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-sage-dark transition">
        <div class="relative">
            <input type="number" step="0.01" min="0" name="echeances[{{ index }}][montant]" value="{{ montant }}" placeholder="0" data-echeance-montant
                class="w-full text-base bg-white border border-slate-200 rounded-xl pl-3 pr-8 py-2 focus:outline-none focus:border-sage-dark transition">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">€</span>
        </div>
        <input type="date" name="echeances[{{ index }}][date]" value="{{ date }}"
            class="w-full text-base bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-sage-dark transition">
        <button type="button" data-echeance-remove title="Retirer" class="justify-self-end w-9 h-9 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
{% endmacro %}

{% block admin_content %}

    <form method="post" data-echeancier-form data-total="{{ devis.total }}">

        <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-linear-to-br from-sage-dark to-sage flex items-center justify-center shrink-0 shadow-md shadow-sage-dark/25">
                <i data-lucide="calendar-check" class="w-5 h-5 text-white"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-0.5">Échéancier de paiement</p>
                <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800 truncate">
                    {{ devis.numero }} · {{ devis.total|number_format(2, ',', ' ')|replace({',00': ''}) }} €
                </h1>
            </div>
        </div>

        {% if verrouille %}
            <div class="bg-white rounded-3xl p-6 md:p-8">
                <p class="text-base text-slate-600">
                    Au moins une échéance est déjà marquée comme payée : l'échéancier n'est plus modifiable.
                    Repasse les paiements en attente depuis la page du projet pour le modifier.
                </p>
                <a href="{{ path('admin_project_show', {id: project.id}) }}" class="inline-block mt-4 text-sm font-medium text-sage-dark hover:underline">Retour au projet</a>
            </div>
        {% else %}
            <div class="bg-white rounded-3xl p-6 md:p-8 mb-4">
                <p class="flex items-center gap-2 font-heading font-medium text-base text-slate-800 mb-2">
                    <span class="w-6 h-6 rounded-md bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="zap" class="w-3.5 h-3.5 text-sage-dark"></i>
                    </span>
                    Répartition rapide
                </p>
                <p class="text-sm text-slate-400 mb-4">Choisis un modèle, tu peux ensuite ajuster chaque ligne.</p>
                <div class="flex flex-wrap gap-2">
                    {% for preset, label in {'full': '100 % à la commande', '30-70': 'Acompte 30 % / solde 70 %', '50-50': 'Acompte 50 % / solde 50 %', 'third': '3 fois égales'} %}
                        <button type="button" data-echeance-preset="{{ preset }}"
                            class="text-sm font-medium text-sage-dark bg-sage-dark/5 hover:bg-sage-dark/10 rounded-full px-4 py-2 transition cursor-pointer">
                            {{ label }}
                        </button>
                    {% endfor %}
                </div>
            </div>

            <div class="bg-white rounded-3xl p-6 md:p-8 mb-4">
                <p class="flex items-center gap-2 font-heading font-medium text-base text-slate-800 mb-4">
                    <span class="w-6 h-6 rounded-md bg-sage-dark/10 flex items-center justify-center">
                        <i data-lucide="list-checks" class="w-3.5 h-3.5 text-sage-dark"></i>
                    </span>
                    Échéances
                </p>

                <div class="flex flex-col gap-2" data-echeance-list>
                    {% for row in rows %}
                        {{ _self.row(loop.index0, row.libelle, row.montant, row.date) }}
                    {% endfor %}
                </div>

                <template data-echeance-template>{{ _self.row('__INDEX__', '', '', '') }}</template>

                <button type="button" data-echeance-add class="mt-4 inline-flex items-center gap-1.5 text-base font-medium text-sage-dark bg-sage-dark/5 hover:bg-sage-dark/10 rounded-full pl-2.5 pr-3.5 py-1.5 transition cursor-pointer">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    Ajouter une échéance
                </button>
            </div>

            <div class="sticky bottom-4 z-20 mt-2 bg-white/90 backdrop-blur-md border border-slate-200 rounded-2xl shadow-lg shadow-slate-900/5 px-4 md:px-5 py-3">
                <div class="flex items-center justify-between gap-4">
                    <div class="min-w-0">
                        <p class="text-xs text-slate-400">Total devis : {{ devis.total|number_format(2, ',', ' ')|replace({',00': ''}) }} €</p>
                        <p class="font-heading font-bold text-xl text-slate-800" data-echeance-reste>—</p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <a href="{{ path('admin_project_show', {id: project.id}) }}" class="hidden sm:block text-sm text-slate-500 hover:text-slate-700 px-3 py-3">Annuler</a>
                        <button type="submit" class="flex items-center gap-2 bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-5 py-3 cursor-pointer hover:opacity-90 transition shadow-md shadow-sage-dark/20">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            Accepter et enregistrer
                        </button>
                    </div>
                </div>
            </div>
        {% endif %}
    </form>

{% endblock %}
