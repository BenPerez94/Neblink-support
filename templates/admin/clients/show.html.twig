{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ client.nom }} - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Clients', path: path('admin_clients')},
        {label: client.nom}
    ]) }}
{% endblock %}

{% block admin_content %}

    <div class="flex items-center justify-between mb-6">
        <div>
            <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Client</p>
            <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800">{{ client.nom }}</h1>
            <p class="text-xs text-slate-400 mt-1">
                {{ client.email }}{% if client.telephone %} · {{ client.telephone }}{% endif %}
            </p>
        </div>
        <a href="{{ path('admin_project_new', {clientId: client.id}) }}" class="flex items-center gap-1.5 bg-sage-dark text-white text-sm font-medium rounded-xl px-4 py-2.5 shrink-0">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nouveau projet
        </a>
    </div>

    {# ---------- Projets web ---------- #}
    <p class="font-heading font-medium text-sm text-slate-800 mb-3">Projets web</p>

    {% if client.projects is empty %}
        <p class="text-sm text-slate-400 mb-8">Aucun projet.</p>
    {% else %}
        <div class="flex flex-col gap-3 mb-8">
            {% for project in client.projects %}
                <div class="bg-white rounded-2xl p-5 flex items-center justify-between gap-3 hover:shadow-md transition">
                    <a href="{{ path('admin_project_show', {id: project.id}) }}" class="flex-1 min-w-0">
                        <p class="font-heading font-medium text-sm text-slate-800">{{ project.titre }}</p>
                        <p class="text-xs text-slate-400 mt-0.5">{{ project.steps|length }} étape{{ project.steps|length > 1 ? 's' : '' }} · {{ project.documents|length }} document{{ project.documents|length > 1 ? 's' : '' }}</p>
                    </a>
                    <div class="flex items-center gap-2 shrink-0">
                        <span class="text-[11px] font-medium px-2.5 py-1 rounded-full
                            {{ project.statut == 'en_attente' ? 'bg-amber-100 text-amber-700' : '' }}
                            {{ project.statut == 'en_cours' ? 'bg-blue-100 text-blue-700' : '' }}
                            {{ project.statut == 'termine' ? 'bg-green-100 text-green-700' : '' }}">
                            {{ project.statut|replace({'_': ' '})|capitalize }}
                        </span>
                        <a href="{{ path('admin_project_edit', {id: project.id}) }}" title="Modifier" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-sage-dark transition">
                            <i data-lucide="pencil" class="w-4 h-4"></i>
                        </a>
                        <form method="post" action="{{ path('admin_project_delete', {id: project.id}) }}" data-confirm-delete data-confirm-title="Supprimer ce projet ?" data-confirm-text="Les étapes et documents associés seront également supprimés.">
                            <button type="submit" title="Supprimer" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ---------- Interventions dépannage ---------- #}
    <p class="font-heading font-medium text-sm text-slate-800 mb-3">Interventions dépannage</p>

    {% set statutLabels = {'en_attente': 'En attente', 'en_cours': 'En cours', 'termine': 'Terminé'} %}
    {% set statutDots = {'en_attente': 'bg-amber-400', 'en_cours': 'bg-blue-400', 'termine': 'bg-green-400'} %}
    {% set statutBadges = {'en_attente': 'bg-amber-100 text-amber-700', 'en_cours': 'bg-blue-100 text-blue-700', 'termine': 'bg-green-100 text-green-700'} %}

    <div class="flex flex-col gap-3 mb-4">
        {% for intervention in client.interventions %}
            <div class="bg-white rounded-2xl p-5 flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                        {% if intervention.titre %}
                            <a href="{{ path('admin_intervention_show', {id: intervention.id}) }}" class="font-heading font-medium text-sm text-slate-800 hover:text-sage-dark transition">{{ intervention.titre }}</a>
                        {% endif %}
                        <span class="text-[11px] font-medium px-2.5 py-1 rounded-full {{ statutBadges[intervention.statut] }}">
                            {{ statutLabels[intervention.statut] ?? intervention.statut }}
                        </span>
                    </div>
                    <div class="flex items-center gap-2 mb-1">
                        <p class="text-xs text-slate-400">{{ intervention.date|date('d/m/Y') }}</p>
                        {% if intervention.montant %}
                            <span class="text-xs font-medium text-sage-dark">{{ intervention.montant|number_format(2, ',', ' ') }} €</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">{{ intervention.description }}</p>
                    {% if intervention.facture %}
                        <a href="{{ asset('uploads/interventions/' ~ intervention.facture) }}" target="_blank" class="inline-flex items-center gap-1.5 text-xs text-sage-dark mt-2 hover:underline">
                            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                            Voir la facture
                        </a>
                    {% endif %}

                    <form method="post" action="{{ path('admin_intervention_update_statut', {id: intervention.id}) }}" class="flex items-center gap-2 mt-3">
                        <div class="relative w-32" data-select-dropdown>
                            <input type="hidden" name="statut" value="{{ intervention.statut }}" data-select-value>
                            <button type="button" data-select-toggle aria-expanded="false"
                                class="w-full flex items-center justify-between gap-1.5 text-xs border border-slate-200 rounded-lg px-2.5 py-1.5 text-slate-700 hover:border-sage-dark/40 transition cursor-pointer">
                                <span class="flex items-center gap-1.5 min-w-0">
                                    <span data-select-dot class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[intervention.statut] }}"></span>
                                    <span data-select-label class="truncate">{{ statutLabels[intervention.statut] ?? intervention.statut }}</span>
                                </span>
                                <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 shrink-0"></i>
                            </button>
                            <div data-select-panel
                                class="absolute left-0 top-[calc(100%+4px)] w-36 bg-white rounded-xl shadow-xl border border-slate-100 p-1 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-30">
                                {% for value, label in statutLabels %}
                                    <button type="button" data-select-option data-value="{{ value }}" data-label="{{ label }}" data-dot-class="{{ statutDots[value] }}"
                                        class="w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-xs text-left transition cursor-pointer {{ intervention.statut == value ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                                        <span class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[value] }}"></span>
                                            {{ label }}
                                        </span>
                                        <i data-lucide="check" class="w-3.5 h-3.5 shrink-0 {{ intervention.statut != value ? 'hidden' : '' }}" data-select-check></i>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                        <button type="submit" title="Mettre à jour le statut" class="w-7 h-7 flex items-center justify-center bg-sage-dark text-white rounded-lg cursor-pointer hover:opacity-90 transition shrink-0">
                            <i data-lucide="check" class="w-3.5 h-3.5"></i>
                        </button>
                    </form>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                    <a href="{{ path('admin_intervention_show', {id: intervention.id}) }}" title="Voir" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-sage-dark transition">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                    </a>
                    <a href="{{ path('admin_intervention_edit', {id: intervention.id}) }}" title="Modifier" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-sage-dark transition">
                        <i data-lucide="pencil" class="w-4 h-4"></i>
                    </a>
                    <form method="post" action="{{ path('admin_intervention_delete', {id: intervention.id}) }}" data-confirm-delete data-confirm-title="Supprimer cette intervention ?">
                        <button type="submit" title="Supprimer" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <p class="text-sm text-slate-400">Aucune intervention.</p>
        {% endfor %}
    </div>

    <div class="bg-white rounded-2xl p-6">
        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-3">Ajouter une intervention</p>
        <form method="post" action="{{ path('admin_intervention_add', {clientId: client.id}) }}" enctype="multipart/form-data" class="flex flex-col gap-3">
            <input type="text" name="titre" placeholder="Titre de l'intervention" required
                class="text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:border-sage-dark">
            <textarea name="description" rows="3" placeholder="Description de l'intervention" required
                class="text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:border-sage-dark resize-none"></textarea>
            <div class="flex flex-col items-center md:flex-row gap-2">
                <div class="relative w-full md:w-40" data-select-dropdown>
                    <input type="hidden" name="statut" value="en_attente" data-select-value>
                    <button type="button" data-select-toggle aria-expanded="false"
                        class="w-full flex items-center justify-between gap-1.5 text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2.5 text-slate-700 hover:border-sage-dark/40 transition cursor-pointer">
                        <span class="flex items-center gap-1.5 min-w-0">
                            <span data-select-dot class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots['en_attente'] }}"></span>
                            <span data-select-label class="truncate">En attente</span>
                        </span>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                    </button>
                    <div data-select-panel
                        class="absolute left-0 top-[calc(100%+4px)] w-full bg-white rounded-xl shadow-xl border border-slate-100 p-1 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-30">
                        {% for value, label in statutLabels %}
                            <button type="button" data-select-option data-value="{{ value }}" data-label="{{ label }}" data-dot-class="{{ statutDots[value] }}"
                                class="w-full flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm text-left transition cursor-pointer {{ value == 'en_attente' ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                                <span class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[value] }}"></span>
                                    {{ label }}
                                </span>
                                <i data-lucide="check" class="w-4 h-4 shrink-0 {{ value != 'en_attente' ? 'hidden' : '' }}" data-select-check></i>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <input type="number" step="0.01" name="montant" placeholder="Montant (€)"
                    class="w-full md:w-40 text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:border-sage-dark">
                <input type="file" name="facture" accept="application/pdf"
                    class="flex-1 text-xs text-slate-500 file:mr-2 file:text-xs file:bg-sage-dark/10 file:text-sage-dark file:rounded-lg file:border-0 file:px-2 file:py-1.5 file:cursor-pointer">
            </div>
            <button type="submit" class="bg-sage-dark text-white text-sm rounded-lg py-2.5 cursor-pointer hover:opacity-90 transition">
                Ajouter l'intervention
            </button>
        </form>
    </div>

{% endblock %}