{% extends 'admin/_layout.html.twig' %}

{% block title %}Nouveau client — Admin Neblink{% endblock %}

{% block admin_content %}

    <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Admin</p>
    <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800 mb-6">Nouveau client</h1>

    <div class="bg-white rounded-2xl p-6 md:p-8 max-w-lg">
        <form method="post">
            <div class="mb-4">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Nom</label>
                <input type="text" name="nom" required
                    class="w-full bg-[#faf9f6] border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sage-dark transition">
            </div>

            <div class="mb-4">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Email</label>
                <input type="email" name="email" required
                    class="w-full bg-[#faf9f6] border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sage-dark transition">
            </div>

            <div class="mb-6">
                <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">Téléphone (optionnel)</label>
                <input type="tel" name="telephone"
                    class="w-full bg-[#faf9f6] border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sage-dark transition">
            </div>

            <button type="submit" class="w-full bg-sage-dark text-white font-heading font-medium text-sm rounded-xl py-3.5 cursor-pointer hover:opacity-90 transition">
                Créer le client et envoyer le lien
            </button>
        </form>
    </div>

{% endblock %}