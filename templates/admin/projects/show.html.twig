{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ project.titre }} — Admin Neblink{% endblock %}

{% block admin_content %}

    <a href="{{ path('admin_client_show', {id: project.client.id}) }}" class="flex items-center gap-1.5 text-xs text-slate-400 hover:text-sage-dark mb-4">
        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
        Retour à {{ project.client.nom }}
    </a>

    <div class="flex items-start justify-between gap-3 mb-6">
        <div>
            <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Projet</p>
            <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800">{{ project.titre }}</h1>
            {% if project.description %}
                <p class="text-sm text-slate-500 mt-2 max-w-lg">{{ project.description }}</p>
            {% endif %}
        </div>

        <form method="post" action="{{ path('admin_project_update_statut', {id: project.id}) }}" class="flex items-center gap-2 shrink-0">
            <select name="statut" class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 focus:outline-none focus:border-sage-dark">
                <option value="en_attente" {{ project.statut == 'en_attente' ? 'selected' }}>En attente</option>
                <option value="en_cours" {{ project.statut == 'en_cours' ? 'selected' }}>En cours</option>
                <option value="termine" {{ project.statut == 'termine' ? 'selected' }}>Terminé</option>
            </select>
            <button type="submit" class="text-xs bg-sage-dark text-white rounded-lg px-3 py-1.5 cursor-pointer hover:opacity-90 transition">
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
            </button>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        {# Étapes #}
        <div class="bg-white rounded-2xl p-6">
            <p class="font-heading font-medium text-sm text-slate-800 mb-4">Étapes</p>

            <div class="flex flex-col gap-2 mb-4">
                {% for step in project.steps %}
                    <div class="flex items-center gap-2.5 group">
                        <form method="post" action="{{ path('admin_project_step_toggle', {id: step.id}) }}">
                            <button type="submit" class="w-5 h-5 shrink-0 rounded-full flex items-center justify-center cursor-pointer {{ step.termine ? 'bg-sage-dark' : 'bg-slate-200 hover:bg-slate-300' }} transition">
                                {% if step.termine %}
                                    <i data-lucide="check" class="w-3 h-3 text-white"></i>
                                {% endif %}
                            </button>
                        </form>
                        <span class="flex-1 text-sm {{ step.termine ? 'text-slate-700' : 'text-slate-500' }}">{{ step.titre }}</span>
                        <form method="post" action="{{ path('admin_project_step_delete', {id: step.id}) }}" class="opacity-0 group-hover:opacity-100 transition">
                            <button type="submit" class="text-slate-300 hover:text-red-400 cursor-pointer">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>
                {% else %}
                    <p class="text-xs text-slate-400">Aucune étape.</p>
                {% endfor %}
            </div>

            <form method="post" action="{{ path('admin_project_step_add', {id: project.id}) }}" class="flex items-center gap-2">
                <input type="text" name="titre" placeholder="Nouvelle étape" required
                    class="flex-1 text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-sage-dark">
                <button type="submit" class="shrink-0 bg-sage-dark text-white rounded-lg px-3 py-2 cursor-pointer hover:opacity-90 transition">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                </button>
            </form>
        </div>

        {# Documents #}
        <div class="bg-white rounded-2xl p-6">
            <p class="font-heading font-medium text-sm text-slate-800 mb-4">Documents</p>

            <div class="flex flex-col gap-2 mb-4">
                {% for document in project.documents %}
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="file-text" class="w-4 h-4 text-slate-400 shrink-0"></i>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-slate-700 truncate">{{ document.nom }}</p>
                            <p class="text-[11px] text-slate-400">
                                {{ document.type|capitalize }}{% if document.montant %} · {{ document.montant|number_format(2, ',', ' ') }} €{% endif %}
                            </p>
                        </div>

                        {% if document.type == 'facture' %}
                            <form method="post" action="{{ path('admin_project_document_payment', {id: document.id}) }}">
                                <button type="submit" class="text-[11px] font-medium px-2 py-1 rounded-full cursor-pointer {{ document.statutPaiement == 'payee' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' }}">
                                    {{ document.statutPaiement == 'payee' ? 'Payée' : 'En attente' }}
                                </button>
                            </form>
                        {% endif %}

                        <form method="post" action="{{ path('admin_project_document_delete', {id: document.id}) }}">
                            <button type="submit" class="text-slate-300 hover:text-red-400 cursor-pointer shrink-0">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>
                {% else %}
                    <p class="text-xs text-slate-400">Aucun document.</p>
                {% endfor %}
            </div>

            <form method="post" action="{{ path('admin_project_document_add', {id: project.id}) }}" enctype="multipart/form-data" class="flex flex-col gap-2 pt-3 border-t border-slate-100">
                <input type="text" name="nom" placeholder="Nom du document" required
                    class="text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-sage-dark">
                <div class="flex items-center gap-2">
                    <select name="type" required class="text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-sage-dark">
                        <option value="devis">Devis</option>
                        <option value="facture">Facture</option>
                    </select>
                    <input type="number" step="0.01" name="montant" placeholder="Montant (€)"
                        class="w-28 text-sm bg-[#faf9f6] border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-sage-dark">
                </div>
                <input type="file" name="fichier" accept="application/pdf" required
                    class="text-xs text-slate-500 file:mr-2 file:text-xs file:bg-sage-dark/10 file:text-sage-dark file:rounded-lg file:border-0 file:px-2 file:py-1.5 file:cursor-pointer">
                <button type="submit" class="bg-sage-dark text-white text-sm rounded-lg py-2 cursor-pointer hover:opacity-90 transition">
                    Ajouter
                </button>
            </form>
        </div>

    </div>

{% endblock %}