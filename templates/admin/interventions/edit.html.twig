{% extends 'admin/_layout.html.twig' %}

{% block title %}Modifier l'intervention - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Interventions', path: path('admin_interventions')},
        {label: intervention.titre ?: 'Intervention', path: path('admin_intervention_show', {id: intervention.id})},
        {label: 'Modifier'}
    ]) }}
{% endblock %}

{% block admin_content %}

    {% set statutLabels = {'en_attente': 'En attente', 'en_cours': 'En cours', 'termine': 'Terminé'} %}
    {% set statutDots = {'en_attente': 'bg-amber-400', 'en_cours': 'bg-blue-400', 'termine': 'bg-green-400'} %}

    <form method="post" enctype="multipart/form-data" class="max-w-3xl pb-28">

        <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 rounded-xl bg-linear-to-br from-sage-dark to-sage flex items-center justify-center shrink-0 shadow-md shadow-sage-dark/25">
                <i data-lucide="wrench" class="w-5 h-5 text-white"></i>
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-0.5">Modifier l'intervention</p>
                <input type="text" name="titre" value="{{ intervention.titre }}" placeholder="Sans titre"
                    class="w-full bg-transparent border-none font-heading font-semibold text-xl md:text-2xl text-slate-800 placeholder:text-slate-300 focus:outline-none px-0 py-0">
            </div>
        </div>

        {# ---------- Propriétés en pilules ---------- #}
        <div class="flex flex-wrap items-center gap-2 pb-6 mb-6 border-b border-slate-200">
            <div class="relative" data-select-dropdown>
                <input type="hidden" name="statut" value="{{ intervention.statut }}" data-select-value>
                <button type="button" data-select-toggle aria-expanded="false"
                    class="flex items-center gap-1.5 bg-white rounded-full pl-3.5 pr-3 py-2 shadow-sm text-sm text-slate-700 hover:shadow-md transition cursor-pointer">
                    <span data-select-dot class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[intervention.statut] }}"></span>
                    <span data-select-label>{{ statutLabels[intervention.statut] ?? intervention.statut }}</span>
                    <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 shrink-0"></i>
                </button>
                <div data-select-panel
                    class="absolute left-0 top-[calc(100%+6px)] w-36 bg-white rounded-xl shadow-xl border border-slate-100 p-1 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-30">
                    {% for value, label in statutLabels %}
                        <button type="button" data-select-option data-value="{{ value }}" data-label="{{ label }}" data-dot-class="{{ statutDots[value] }}"
                            class="w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-xs text-left transition cursor-pointer {{ intervention.statut == value ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                            <span class="flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[value] }}"></span>
                                {{ label }}
                            </span>
                            <i data-lucide="check" class="w-3.5 h-3.5 shrink-0 {{ intervention.statut != value ? 'hidden' : '' }}" data-select-check></i>
                        </button>
                    {% endfor %}
                </div>
            </div>

            <label class="flex items-center gap-2 bg-white rounded-full pl-3.5 pr-3.5 py-2 shadow-sm has-[input:focus]:ring-2 has-[input:focus]:ring-sage-dark/25 transition">
                <i data-lucide="calendar" class="w-3.5 h-3.5 text-sage-dark shrink-0"></i>
                <input type="date" name="date" required value="{{ intervention.date|date('Y-m-d') }}"
                    class="w-[112px] bg-transparent text-sm text-slate-700 focus:outline-none">
            </label>

            <label class="flex items-center gap-2 bg-white rounded-full pl-3.5 pr-3.5 py-2 shadow-sm has-[input:focus]:ring-2 has-[input:focus]:ring-sage-dark/25 transition">
                <i data-lucide="euro" class="w-3.5 h-3.5 text-sage-dark shrink-0"></i>
                <input type="number" step="0.01" name="montant" value="{{ intervention.montant }}" placeholder="Montant"
                    class="w-20 bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none">
            </label>
        </div>

        {# ---------- Description, effet "page" ---------- #}
        <div class="bg-white rounded-3xl shadow-sm p-6 md:p-8 mb-4">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-3">Description</p>
            <textarea name="description" required placeholder="Détail de l'intervention réalisée..."
                class="w-full min-h-[260px] bg-transparent border-none text-sm text-slate-700 leading-relaxed placeholder:text-slate-300 focus:outline-none resize-none px-0">{{ intervention.description }}</textarea>
        </div>

        {# ---------- Facture ---------- #}
        <div class="flex items-center gap-3 bg-white rounded-2xl shadow-sm px-5 py-4">
            <div class="w-10 h-10 rounded-xl bg-sage-dark/10 flex items-center justify-center shrink-0">
                <i data-lucide="file-text" class="w-4.5 h-4.5 text-sage-dark"></i>
            </div>
            <div class="flex-1 min-w-0">
                {% if intervention.facture %}
                    <a href="{{ asset('uploads/interventions/' ~ intervention.facture) }}" target="_blank" class="text-sm font-medium text-slate-800 hover:text-sage-dark transition">Facture actuelle</a>
                    <p class="text-xs text-slate-400 mt-0.5">Laisser le champ vide pour la conserver</p>
                {% else %}
                    <p class="text-sm font-medium text-slate-700">Aucune facture</p>
                    <p class="text-xs text-slate-400 mt-0.5">Format PDF uniquement</p>
                {% endif %}
                <input type="file" name="facture" accept="application/pdf"
                    class="mt-2 text-xs text-slate-500 file:mr-2 file:text-xs file:font-medium file:bg-sage-dark file:text-white file:rounded-lg file:border-0 file:px-3 file:py-1.5 file:cursor-pointer hover:file:opacity-90">
            </div>
        </div>

        {# ---------- Barre d'actions flottante ---------- #}
        <div class="fixed bottom-0 left-0 md:left-56 right-0 bg-white/90 backdrop-blur-md border-t border-slate-200 px-4 md:px-8 py-4 z-20">
            <div class="max-w-3xl flex items-center gap-3">
                <button type="submit" class="bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-6 py-3 cursor-pointer hover:opacity-90 transition shadow-md shadow-sage-dark/20">
                    Enregistrer les modifications
                </button>
                <a href="{{ path('admin_intervention_show', {id: intervention.id}) }}" class="text-sm text-slate-500 hover:text-slate-700 px-3 py-3">
                    Annuler
                </a>
            </div>
        </div>
    </form>

{% endblock %}
