{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ intervention.titre ?: 'Intervention' }} - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Interventions', path: path('admin_interventions')},
        {label: intervention.titre ?: 'Intervention'}
    ]) }}
{% endblock %}

{% block admin_content %}

    {% set statutLabels = {'en_attente': 'En attente', 'en_cours': 'En cours', 'termine': 'Terminé'} %}
    {% set statutDots = {'en_attente': 'bg-amber-400', 'en_cours': 'bg-blue-400', 'termine': 'bg-green-400'} %}

    {# ---------- En-tête (carte vedette) ---------- #}
    <div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-sage-dark via-sage to-sage-light p-6 md:p-8 mb-5 text-white shadow-lg shadow-sage-dark/15">
        <div class="absolute w-64 h-64 rounded-full bg-white/10 blur-3xl -top-20 -right-14"></div>
        <i data-lucide="wrench" class="absolute -right-4 -bottom-6 w-32 h-32 text-white/[0.07]"></i>

        <div class="relative flex flex-col md:flex-row md:items-start md:justify-between gap-5">
            <div class="min-w-0">
                <form method="post" action="{{ path('admin_intervention_update_statut', {id: intervention.id}) }}" class="inline-flex items-center gap-2 mb-3">
                    <div class="relative" data-select-dropdown>
                        <input type="hidden" name="statut" value="{{ intervention.statut }}" data-select-value>
                        <button type="button" data-select-toggle aria-expanded="false"
                            class="flex items-center gap-1.5 bg-white/15 hover:bg-white/25 backdrop-blur-sm text-white text-xs font-medium pl-3 pr-2.5 py-1.5 rounded-full transition cursor-pointer">
                            <span data-select-dot class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[intervention.statut] }}"></span>
                            <span data-select-label>{{ statutLabels[intervention.statut] ?? intervention.statut }}</span>
                            <i data-lucide="chevron-down" class="w-3 h-3 text-white/70 shrink-0"></i>
                        </button>
                        <div data-select-panel
                            class="absolute left-0 top-[calc(100%+6px)] w-36 bg-white rounded-xl shadow-xl border border-slate-100 p-1 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-30">
                            {% for value, label in statutLabels %}
                                <button type="button" data-select-option data-value="{{ value }}" data-label="{{ label }}" data-dot-class="{{ statutDots[value] }}"
                                    class="w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-xs text-left transition cursor-pointer {{ intervention.statut == value ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                                    <span class="flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full shrink-0 {{ statutDots[value] }}"></span>
                                        {{ label }}
                                    </span>
                                    <i data-lucide="check" class="w-3.5 h-3.5 shrink-0 {{ intervention.statut != value ? 'hidden' : '' }}" data-select-check></i>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                    <button type="submit" title="Mettre à jour le statut" class="w-7 h-7 flex items-center justify-center bg-white/15 hover:bg-white/25 text-white rounded-full cursor-pointer transition shrink-0">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    </button>
                </form>

                <h1 class="font-heading font-semibold text-2xl md:text-3xl truncate">{{ intervention.titre ?: 'Sans titre' }}</h1>
                <p class="text-sm text-white/70 mt-2">
                    <a href="{{ path('admin_client_show', {id: intervention.client.id}) }}" class="hover:text-white transition underline decoration-white/30 underline-offset-2">{{ intervention.client.nom }}</a>
                    · {{ intervention.date|date('d/m/Y') }}
                </p>
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <a href="{{ path('admin_intervention_edit', {id: intervention.id}) }}" title="Modifier" class="w-10 h-10 flex items-center justify-center bg-white/15 hover:bg-white/25 rounded-xl transition">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                </a>
                <form method="post" action="{{ path('admin_intervention_delete', {id: intervention.id}) }}" data-confirm-delete data-confirm-title="Supprimer cette intervention ?">
                    <button type="submit" title="Supprimer" class="w-10 h-10 flex items-center justify-center bg-white/15 hover:bg-red-400/40 rounded-xl cursor-pointer transition">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# ---------- Détails ---------- #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2 bg-white rounded-3xl p-6 md:p-8">
            <p class="font-heading font-medium text-base text-slate-800 mb-3">Description</p>
            <p class="text-base text-slate-600 leading-relaxed whitespace-pre-line">{{ intervention.description }}</p>
        </div>

        <div class="flex flex-col gap-4">
            {% if intervention.montant %}
                <div class="bg-white rounded-2xl p-5">
                    <div class="w-10 h-10 rounded-xl bg-linear-to-br from-sage-dark to-sage flex items-center justify-center mb-3 shadow-md shadow-sage-dark/25">
                        <i data-lucide="euro" class="w-4.5 h-4.5 text-white"></i>
                    </div>
                    <p class="font-heading font-bold text-xl text-slate-800">{{ intervention.montant|number_format(2, ',', ' ') }} €</p>
                    <p class="text-xs text-slate-400 mt-0.5">Montant de l'intervention</p>
                </div>
            {% endif %}

            {% if intervention.facture %}
                <a href="{{ asset('uploads/interventions/' ~ intervention.facture) }}" target="_blank" class="group bg-white rounded-2xl p-5 hover:shadow-lg hover:shadow-slate-900/5 transition">
                    <div class="w-10 h-10 rounded-xl bg-linear-to-br from-purple-600 to-purple-400 flex items-center justify-center mb-3 shadow-md shadow-purple-500/25">
                        <i data-lucide="file-text" class="w-4.5 h-4.5 text-white"></i>
                    </div>
                    <p class="font-heading font-semibold text-sm text-slate-800 group-hover:text-sage-dark transition">Voir la facture</p>
                    <p class="text-xs text-slate-400 mt-0.5">Document PDF</p>
                </a>
            {% endif %}

            {% if not intervention.montant and not intervention.facture %}
                <div class="bg-white rounded-2xl p-5 flex flex-col items-center justify-center text-center py-8">
                    <div class="w-10 h-10 rounded-full bg-[#faf9f6] flex items-center justify-center mb-3">
                        <i data-lucide="euro" class="w-4 h-4 text-slate-300"></i>
                    </div>
                    <p class="text-xs text-slate-400">Aucun montant ni facture renseignés.</p>
                </div>
            {% endif %}
        </div>
    </div>

{% endblock %}
