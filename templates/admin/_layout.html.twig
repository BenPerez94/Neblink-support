{% extends 'base.html.twig' %}

{% block nav_light %}false{% endblock %}

{% block header_bg %}hidden{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col md:flex-row bg-[#f4f2ec]">

        {# Barre mobile avec burger #}
        <div class="md:hidden sticky top-0 z-30 flex items-center justify-between px-4 py-3.5 bg-linear-to-r from-[#2f5443] to-sage-dark shadow-md">
            <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-2">
                <img src="{{ asset('images/logo.svg') }}" alt="Neblink" class="w-6 h-6">
                <span class="text-white font-heading font-semibold text-sm">Neblink</span>
            </a>
            <button type="button" id="admin-burger-btn" class="relative w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-lg hover:bg-white/10 transition cursor-pointer" aria-label="Ouvrir le menu" aria-expanded="false">
                <span data-burger-bar class="w-5 h-0.5 bg-white rounded-full transition-all duration-300 ease-out"></span>
                <span data-burger-bar class="w-5 h-0.5 bg-white rounded-full transition-all duration-300 ease-out"></span>
                <span data-burger-bar class="w-5 h-0.5 bg-white rounded-full transition-all duration-300 ease-out"></span>
            </button>
        </div>

        {# Fond assombri derrière le tiroir, mobile uniquement #}
        <div id="admin-sidebar-backdrop" class="md:hidden fixed inset-0 bg-slate-900/50 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-300 z-40"></div>

        <aside id="admin-sidebar" class="fixed md:sticky inset-y-0 left-0 md:inset-auto md:top-0 z-50 md:z-auto w-72 max-w-[85%] md:w-56 md:max-w-none md:h-screen shrink-0 self-start bg-linear-to-b from-[#2f5443] to-sage-dark p-5 md:p-6 flex flex-col gap-1 -translate-x-full md:translate-x-0 transition-transform duration-300 ease-out shadow-2xl md:shadow-none overflow-y-auto">

            <div class="flex items-center justify-between gap-2 mb-8 px-2">
                <div class="flex items-center gap-2">
                    <img src="{{ asset('images/logo.svg') }}" alt="Neblink" class="w-7 h-7">
                    <span class="text-white font-heading font-semibold text-sm">Neblink</span>
                </div>
                <button type="button" id="admin-sidebar-close" class="md:hidden w-8 h-8 flex items-center justify-center rounded-lg text-white/70 hover:bg-white/10 transition cursor-pointer" aria-label="Fermer le menu">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="flex flex-col gap-1">
                <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_dashboard' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    Vue d'ensemble
                </a>
                <a href="{{ path('admin_messages') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_message' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                    Messages
                    {% set nbNouveaux = nouveaux_messages_count() %}
                    {% if nbNouveaux > 0 %}
                        <span class="ml-auto bg-red-400 text-white text-[10px] px-1.5 py-0.5 rounded-full">{{ nbNouveaux }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('admin_clients') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_client' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    Clients
                </a>
                <a href="{{ path('admin_projects') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_project' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="folder-kanban" class="w-4 h-4"></i>
                    Projets
                </a>
                <a href="{{ path('admin_interventions') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_intervention' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="wrench" class="w-4 h-4"></i>
                    Interventions
                </a>
            </div>

            <div class="flex flex-col gap-1 mt-auto pt-4 border-t border-white/10">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/50 hover:bg-white/10">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    Retour au site
                </a>
                <form method="post" action="{{ path('app_logout') }}">
                    <button type="submit" class="w-full flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/50 hover:bg-white/10 cursor-pointer">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        Déconnexion
                    </button>
                </form>
            </div>

        </aside>

        <main class="flex-1 p-6 md:p-8">
            {% block breadcrumb %}{% endblock %}
            {% block admin_content %}{% endblock %}
        </main>

    </div>
{% endblock %}