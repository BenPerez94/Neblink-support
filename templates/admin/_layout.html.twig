{% extends 'base.html.twig' %}

{% block nav_light %}false{% endblock %}

{% block header_bg %}hidden{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col md:flex-row bg-[#f4f2ec]">

        <aside class="w-full md:w-56 shrink-0 bg-linear-to-b from-[#2f5443] to-sage-dark p-4 md:p-6 flex items-center md:flex-col gap-1 pb-4 md:pb-0">

            <div class="hidden md:flex items-center gap-2 mb-8 px-2">
                <img src="{{ asset('images/logo.svg') }}" alt="Neblink" class="w-7 h-7">
                <span class="text-white font-heading font-semibold text-sm">Neblink</span>
            </div>

            <div class="flex items-center gap-1 overflow-x-auto md:flex-col md:items-stretch md:overflow-visible md:w-full">
                <a href="{{ path('admin_dashboard') }}" class="shrink-0 flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_dashboard' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    Vue d'ensemble
                </a>
                <a href="{{ path('admin_messages') }}" class="shrink-0 flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_message' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                    Messages
                    {% if nouveauxMessagesCount is defined and nouveauxMessagesCount > 0 %}
                        <span class="ml-auto bg-red-400 text-white text-[10px] px-1.5 py-0.5 rounded-full">{{ nouveauxMessagesCount }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('admin_clients') }}" class="shrink-0 flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm {{ app.request.attributes.get('_route') starts with 'admin_client' ? 'bg-white/15 text-white font-medium' : 'text-white/65 hover:bg-white/10' }}">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    Clients
                </a>
            </div>

            {# Liens visibles directement en desktop #}
            <div class="hidden md:flex md:flex-col md:gap-1 md:mt-auto md:pt-4 md:border-t md:border-white/10 md:w-full">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/50 hover:bg-white/10">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    Retour au site
                </a>
                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/50 hover:bg-white/10">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    Déconnexion
                </a>
            </div>

            {# Menu "3 points", mobile uniquement #}
            <div class="relative shrink-0 ml-auto md:hidden">
                <button type="button" id="admin-more-btn" class="w-9 h-9 flex items-center justify-center rounded-lg text-white/65 hover:bg-white/10" aria-label="Plus d'options" aria-expanded="false">
                    <i data-lucide="more-vertical" class="w-4 h-4"></i>
                </button>

                <div id="admin-more-panel" class="fixed w-48 bg-[#2f5443] border border-white/10 rounded-xl p-1.5 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-100 shadow-xl">
                    <a href="{{ path('app_home') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/70 hover:bg-white/10">
                        <i data-lucide="external-link" class="w-4 h-4"></i>
                        Retour au site
                    </a>
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-white/70 hover:bg-white/10">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        Déconnexion
                    </a>
                </div>
            </div>

        </aside>

        <main class="flex-1 p-6 md:p-8">
            {% block admin_content %}{% endblock %}
        </main>

    </div>
{% endblock %}