{% extends 'admin/_layout.html.twig' %}

{% block title %}Catégories et tags - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Blog', path: path('admin_blog')},
        {label: 'Catégories et tags'}
    ]) }}
{% endblock %}

{% block admin_content %}

    {% set inputClass = 'w-full bg-[#faf9f6] border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:border-sage-dark transition' %}

    <div class="mb-6">
        <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Blog</p>
        <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800">Catégories et tags</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-5 items-start">

        {# ---------- Catégories ---------- #}
        <div class="bg-white rounded-2xl p-6">
            <div class="flex items-center justify-between mb-1">
                <p class="font-heading font-medium text-slate-800">Catégories</p>
                <span class="text-xs text-slate-400">{{ categories|length }}</span>
            </div>
            <p class="text-xs text-slate-400 mb-5">Une seule catégorie par article. Chaque catégorie a sa page publique, la description y est affichée.</p>

            <div class="flex flex-col divide-y divide-slate-100 mb-5">
                {% for category in categories %}
                    <div class="py-3" data-step-row>
                        <div data-step-display class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-800">{{ category.nom }}</p>
                                <p class="text-xs text-slate-400">/blog/categorie/{{ category.slug }} · {{ category.articles|length }} article{{ category.articles|length > 1 ? 's' }}</p>
                                {% if category.description %}
                                    <p class="text-xs text-slate-500 mt-1">{{ category.description }}</p>
                                {% endif %}
                            </div>
                            <div class="flex items-center gap-1 shrink-0">
                                <button type="button" data-step-edit-toggle title="Modifier" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-sage-dark cursor-pointer transition">
                                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                </button>
                                <form method="post" action="{{ path('admin_blog_category_delete', {id: category.id}) }}" data-confirm-delete data-confirm-title="Supprimer cette catégorie ?" data-confirm-text="Ses articles seront conservés, sans catégorie.">
                                    <button type="submit" title="Supprimer" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <form method="post" action="{{ path('admin_blog_category_edit', {id: category.id}) }}" data-step-edit class="hidden flex flex-col gap-2.5">
                            <input type="text" name="nom" value="{{ category.nom }}" required class="{{ inputClass }}">
                            <textarea name="description" rows="2" placeholder="Description (optionnel)" class="{{ inputClass }} resize-none">{{ category.description }}</textarea>
                            <div class="flex items-center gap-3">
                                <button type="submit" class="bg-sage-dark text-white text-sm font-medium rounded-xl px-4 py-2 cursor-pointer hover:opacity-90 transition">Enregistrer</button>
                                <button type="button" data-step-edit-cancel class="text-sm text-slate-400 hover:text-slate-600 cursor-pointer">Annuler</button>
                            </div>
                        </form>
                    </div>
                {% else %}
                    <p class="text-sm text-slate-400 py-3">Aucune catégorie pour l'instant.</p>
                {% endfor %}
            </div>

            <form method="post" action="{{ path('admin_blog_category_add') }}" class="flex flex-col gap-2.5 pt-5 border-t border-slate-100">
                <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Nouvelle catégorie</p>
                <input type="text" name="nom" required placeholder="Sécurité" class="{{ inputClass }}">
                <textarea name="description" rows="2" placeholder="Description (optionnel)" class="{{ inputClass }} resize-none"></textarea>
                <button type="submit" class="self-start flex items-center gap-1.5 bg-sage-dark text-white text-sm font-medium rounded-xl px-4 py-2.5 cursor-pointer hover:opacity-90 transition">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Ajouter
                </button>
            </form>
        </div>

        {# ---------- Tags ---------- #}
        <div class="bg-white rounded-2xl p-6">
            <div class="flex items-center justify-between mb-1">
                <p class="font-heading font-medium text-slate-800">Tags</p>
                <span class="text-xs text-slate-400">{{ tags|length }}</span>
            </div>
            <p class="text-xs text-slate-400 mb-5">Ils se créent automatiquement depuis le formulaire d'un article.</p>

            <div class="flex flex-wrap gap-2">
                {% for tag in tags %}
                    <div class="inline-flex items-center gap-1 bg-[#faf9f6] border border-slate-200 rounded-full pl-3 pr-1 py-1">
                        <span class="text-xs text-slate-600">#{{ tag.nom }}</span>
                        <span class="text-[11px] text-slate-400">{{ tag.articles|length }}</span>
                        <form method="post" action="{{ path('admin_blog_tag_delete', {id: tag.id}) }}" data-confirm-delete data-confirm-title="Supprimer ce tag ?" data-confirm-text="Il sera retiré des articles qui l'utilisent.">
                            <button type="submit" title="Supprimer" class="w-5 h-5 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
                                <i data-lucide="x" class="w-3 h-3"></i>
                            </button>
                        </form>
                    </div>
                {% else %}
                    <p class="text-sm text-slate-400">Aucun tag pour l'instant.</p>
                {% endfor %}
            </div>
        </div>
    </div>

{% endblock %}
