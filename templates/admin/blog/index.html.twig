{% extends 'admin/_layout.html.twig' %}

{% block title %}Blog - Admin Neblink{% endblock %}

{% import 'admin/_breadcrumb.html.twig' as breadcrumb %}
{% block breadcrumb %}
    {{ breadcrumb.render([
        {label: 'Tableau de bord', path: path('admin_dashboard')},
        {label: 'Blog'}
    ]) }}
{% endblock %}

{% block admin_content %}

    {% set etatLabels = {
        'brouillon': 'Brouillon',
        'programme': 'Programmé',
        'publie': 'Publié'
    } %}
    {% set etatDots = {
        'brouillon': 'bg-slate-400',
        'programme': 'bg-amber-400',
        'publie': 'bg-green-400'
    } %}

    {% set activeFilters = {} %}
    {% for key, value in filterValues %}
        {% if value is not empty %}
            {% set activeFilters = activeFilters|merge({(key): value}) %}
        {% endif %}
    {% endfor %}

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
            <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Admin</p>
            <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800">Blog</h1>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('admin_blog_taxonomies') }}" class="flex items-center gap-1.5 bg-white text-slate-600 text-sm rounded-xl px-4 py-2.5 shadow-sm hover:text-sage-dark transition">
                <i data-lucide="tags" class="w-4 h-4"></i>
                Catégories et tags
            </a>
            <a href="{{ path('admin_blog_import') }}" class="flex items-center gap-1.5 bg-white text-slate-600 text-sm rounded-xl px-4 py-2.5 shadow-sm hover:text-sage-dark transition">
                <i data-lucide="download" class="w-4 h-4"></i>
                Importer
            </a>
            <a href="{{ path('admin_blog_new') }}" class="flex items-center gap-1.5 bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-4 py-2.5 hover:opacity-90 transition">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Nouvel article
            </a>
        </div>
    </div>

    <form method="get" class="flex flex-col md:flex-row md:flex-wrap md:items-center gap-2.5 md:gap-2 mb-5">
        <div class="relative w-full md:w-auto" data-select-dropdown>
            <input type="hidden" name="etat" value="{{ filterValues.etat }}" data-select-value>

            <button type="button" data-select-toggle aria-expanded="false"
                class="w-full md:w-auto flex items-center justify-between md:justify-start gap-2 bg-white rounded-2xl md:rounded-full px-4 py-3 md:py-2.5 shadow-sm text-sm text-slate-700 hover:shadow-md transition cursor-pointer">
                <span class="flex items-center gap-2 min-w-0">
                    <i data-lucide="flag" class="w-4 h-4 text-sage-dark shrink-0"></i>
                    <span data-select-label class="truncate">{{ filterValues.etat ? etatLabels[filterValues.etat] : 'Tous les statuts' }}</span>
                </span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
            </button>

            <div data-select-panel
                class="absolute left-0 top-[calc(100%+8px)] w-full md:w-52 bg-white rounded-2xl shadow-xl border border-slate-100 p-1.5 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-50">
                <button type="button" data-select-option data-value="" data-label="Tous les statuts"
                    class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm text-left transition cursor-pointer {{ filterValues.etat is empty ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                    Tous les statuts
                    <i data-lucide="check" class="w-4 h-4 shrink-0 {{ filterValues.etat is not empty ? 'hidden' : '' }}" data-select-check></i>
                </button>
                {% for value, label in etatLabels %}
                    <button type="button" data-select-option data-value="{{ value }}" data-label="{{ label }}"
                        class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm text-left transition cursor-pointer {{ filterValues.etat == value ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                        <span class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full {{ etatDots[value] }}"></span>
                            {{ label }}
                        </span>
                        <i data-lucide="check" class="w-4 h-4 shrink-0 {{ filterValues.etat != value ? 'hidden' : '' }}" data-select-check></i>
                    </button>
                {% endfor %}
            </div>
        </div>

        <div class="relative w-full md:w-auto" data-select-dropdown>
            <input type="hidden" name="categoryId" value="{{ filterValues.categoryId }}" data-select-value>

            <button type="button" data-select-toggle aria-expanded="false"
                class="w-full md:w-auto flex items-center justify-between md:justify-start gap-2 bg-white rounded-2xl md:rounded-full px-4 py-3 md:py-2.5 shadow-sm text-sm text-slate-700 hover:shadow-md transition cursor-pointer">
                <span class="flex items-center gap-2 min-w-0">
                    <i data-lucide="folder-kanban" class="w-4 h-4 text-sage-dark shrink-0"></i>
                    <span data-select-label class="truncate">{{ selectedCategory ? selectedCategory.nom : 'Toutes les catégories' }}</span>
                </span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
            </button>

            <div data-select-panel
                class="absolute left-0 top-[calc(100%+8px)] w-full md:w-60 bg-white rounded-2xl shadow-xl border border-slate-100 p-1.5 opacity-0 -translate-y-2 pointer-events-none transition-all duration-150 z-50 max-h-72 overflow-y-auto">
                <button type="button" data-select-option data-value="" data-label="Toutes les catégories"
                    class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm text-left transition cursor-pointer {{ selectedCategory is null ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                    Toutes les catégories
                    <i data-lucide="check" class="w-4 h-4 shrink-0 {{ selectedCategory is not null ? 'hidden' : '' }}" data-select-check></i>
                </button>
                {% for category in categories %}
                    <button type="button" data-select-option data-value="{{ category.id }}" data-label="{{ category.nom }}"
                        class="w-full flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm text-left transition cursor-pointer {{ selectedCategory and selectedCategory.id == category.id ? 'text-sage-dark font-medium bg-sage-dark/5' : 'text-slate-600 hover:bg-[#faf9f6]' }}">
                        <span class="truncate">{{ category.nom }}</span>
                        <i data-lucide="check" class="w-4 h-4 shrink-0 {{ not (selectedCategory and selectedCategory.id == category.id) ? 'hidden' : '' }}" data-select-check></i>
                    </button>
                {% endfor %}
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button type="submit" class="flex-1 md:flex-none flex items-center justify-center md:justify-start gap-1.5 bg-sage-dark text-white text-sm font-medium rounded-2xl md:rounded-full px-4 py-3 md:py-2.5 cursor-pointer hover:opacity-90 transition shadow-sm">
                <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                Filtrer
            </button>

            {% if activeFilters is not empty %}
                <a href="{{ path('admin_blog') }}"
                    class="shrink-0 flex items-center gap-1 text-xs text-slate-400 hover:text-red-400 transition px-3 py-3 md:px-2 md:py-2.5">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    Réinitialiser
                </a>
            {% endif %}
        </div>
    </form>

    {% if articles is empty %}
        <div class="bg-white rounded-2xl text-center py-16 px-6">
            <i data-lucide="newspaper" class="w-8 h-8 text-sage-light mx-auto mb-3"></i>
            {% if activeFilters is not empty %}
                <p class="text-sm text-slate-400">Aucun article ne correspond à ces critères.</p>
            {% else %}
                <p class="font-heading font-medium text-slate-700 mb-1">Écrivez votre premier article</p>
                <p class="text-sm text-slate-400 mb-5">Il restera en brouillon tant que vous ne le publiez pas.</p>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    <a href="{{ path('admin_blog_new') }}" class="inline-flex items-center gap-1.5 bg-sage-dark text-white font-heading font-medium text-sm rounded-xl px-4 py-2.5 hover:opacity-90 transition">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Nouvel article
                    </a>
                    <a href="{{ path('admin_blog_import') }}" class="inline-flex items-center gap-1.5 bg-[#faf9f6] border border-slate-200 text-slate-600 text-sm rounded-xl px-4 py-2.5 hover:text-sage-dark transition">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        Importer un fichier
                    </a>
                </div>
            {% endif %}
        </div>
    {% else %}
        {# ---------- Cartes (mobile) ---------- #}
        <div class="md:hidden flex flex-col gap-3">
            {% for article in articles %}
                <div class="bg-white rounded-2xl p-4">
                    <div class="flex items-start justify-between gap-2 mb-1.5">
                        <a href="{{ path('admin_blog_edit', {id: article.id}) }}" class="font-heading font-medium text-sm text-slate-800 hover:text-sage-dark transition">{{ article.titre }}</a>
                        {% include 'admin/blog/_etat_badge.html.twig' %}
                    </div>
                    <p class="text-xs text-slate-400 mb-2">
                        {{ article.category ? article.category.nom : 'Sans catégorie' }}
                        · {{ article.datePublication ? article.datePublication|date('d/m/Y H:i') : 'Non daté' }}
                    </p>
                    <div class="flex items-center gap-1 -ml-1.5">
                        {% include 'admin/blog/_une_toggle.html.twig' with {article: article, taille: 'w-3.5 h-3.5', bouton: 'w-7 h-7'} only %}
                        <a href="{{ path('blog_show', {slug: article.slug}) }}" target="_blank" title="Voir" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-sage-dark transition">
                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        </a>
                        <a href="{{ path('admin_blog_edit', {id: article.id}) }}" title="Modifier" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-sage-dark transition">
                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                        </a>
                        <form method="post" action="{{ path('admin_blog_delete', {id: article.id}) }}" data-confirm-delete data-confirm-title="Supprimer cet article ?" data-confirm-text="L'article sera définitivement supprimé.">
                            <button type="submit" title="Supprimer" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-red-400 cursor-pointer transition">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ---------- Tableau (desktop) ---------- #}
        <div class="hidden md:block bg-white rounded-2xl overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs font-medium text-slate-400 uppercase tracking-wide border-b border-slate-100">
                        <th class="px-5 py-3.5">Titre</th>
                        <th class="px-5 py-3.5">Catégorie</th>
                        <th class="px-5 py-3.5">Statut</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Publication</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Modifié le</th>
                        <th class="px-5 py-3.5"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        <tr class="{% if not loop.last %}border-b border-slate-50{% endif %} hover:bg-[#faf9f6] transition">
                            <td class="px-5 py-3.5">
                                <a href="{{ path('admin_blog_edit', {id: article.id}) }}" class="font-medium text-slate-800 hover:text-sage-dark transition">
                                    {{ article.titre }}
                                </a>
                                <p class="text-xs text-slate-400 mt-0.5">{{ article.tempsLecture }} min de lecture</p>
                            </td>
                            <td class="px-5 py-3.5 text-slate-500 whitespace-nowrap">{{ article.category ? article.category.nom : '—' }}</td>
                            <td class="px-5 py-3.5 whitespace-nowrap">{% include 'admin/blog/_etat_badge.html.twig' %}</td>
                            <td class="px-5 py-3.5 text-slate-500 whitespace-nowrap">{{ article.datePublication ? article.datePublication|date('d/m/Y H:i') : '—' }}</td>
                            <td class="px-5 py-3.5 text-slate-400 text-xs whitespace-nowrap">{{ article.updatedAt|date('d/m/Y H:i') }}</td>
                            <td class="px-5 py-3.5 whitespace-nowrap text-right">
                                <div class="inline-flex items-center">
                                    {% include 'admin/blog/_une_toggle.html.twig' with {article: article, taille: 'w-4 h-4', bouton: 'w-8 h-8'} only %}
                                    <a href="{{ path('blog_show', {slug: article.slug}) }}" target="_blank" title="{{ article.etat == 'publie' ? 'Voir sur le site' : 'Aperçu' }}" class="inline-flex items-center justify-center w-8 h-8 text-slate-300 hover:text-sage-dark transition">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                    <a href="{{ path('admin_blog_edit', {id: article.id}) }}" title="Modifier" class="inline-flex items-center justify-center w-8 h-8 text-slate-300 hover:text-sage-dark transition">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_blog_delete', {id: article.id}) }}" data-confirm-delete data-confirm-title="Supprimer cet article ?" data-confirm-text="L'article sera définitivement supprimé.">
                                        <button type="submit" title="Supprimer" class="inline-flex items-center justify-center w-8 h-8 text-slate-300 hover:text-red-400 cursor-pointer transition">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

{% endblock %}
