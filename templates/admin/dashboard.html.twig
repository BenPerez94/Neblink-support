{% extends 'admin/_layout.html.twig' %}

{% block title %}Tableau de bord - Admin Neblink{% endblock %}

{% block admin_content %}

{% set avatarColors = [
    'bg-teal-500/10 text-teal-600',
    'bg-cyan-500/10 text-cyan-600',
    'bg-violet-500/10 text-violet-600',
    'bg-purple-500/10 text-purple-600',
    'bg-fuchsia-500/10 text-fuchsia-600',
    'bg-rose-500/10 text-rose-600',
    'bg-orange-700/10 text-orange-800',
    'bg-indigo-500/10 text-indigo-600',
    'bg-teal-700/10 text-teal-800',
    'bg-cyan-700/10 text-cyan-800'
] %}

    <p class="text-xs font-medium text-sage-dark uppercase tracking-wide mb-1">Admin</p>
    <h1 class="font-heading font-semibold text-xl md:text-2xl text-slate-800 mb-6">Vue d'ensemble</h1>

    {# ---------- Chiffre d'affaires (carte vedette) ---------- #}
    <div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-sage-dark via-sage to-sage-light p-6 md:p-8 mb-4 text-white shadow-lg shadow-sage-dark/15">
        <div class="absolute w-64 h-64 rounded-full bg-white/10 blur-3xl -top-20 -right-14"></div>
        <div class="relative flex flex-col md:flex-row md:items-end md:justify-between gap-5">
            <div>
                <p class="text-xs font-medium uppercase tracking-wide text-white/70 mb-2">Chiffre d'affaires ce mois</p>
                <p class="font-heading font-semibold text-3xl md:text-4xl">{{ montantTotalCeMois|number_format(0, ',', ' ') }} €</p>
            </div>
            <div class="flex items-center gap-6 md:gap-8">
                <div>
                    <p class="text-[11px] text-white/60 uppercase tracking-wide mb-1">Interventions</p>
                    <p class="font-heading font-semibold text-lg">{{ montantInterventionsCeMois|number_format(0, ',', ' ') }} €</p>
                </div>
                <div class="w-px h-8 bg-white/15"></div>
                <div>
                    <p class="text-[11px] text-white/60 uppercase tracking-wide mb-1">Projets</p>
                    <p class="font-heading font-semibold text-lg">{{ montantFacturesCeMois|number_format(0, ',', ' ') }} €</p>
                </div>
            </div>
        </div>
    </div>

    {# ---------- KPIs ---------- #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <a href="{{ path('admin_messages') }}" class="group relative overflow-hidden bg-white rounded-3xl p-5 hover:shadow-xl hover:shadow-slate-900/5 hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="mail" class="absolute -right-3 -top-3 w-24 h-24 text-sage-dark/5 group-hover:text-sage-dark/10 group-hover:scale-110 transition-all duration-300"></i>
            <div class="relative">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-11 h-11 rounded-xl bg-linear-to-br from-sage-dark to-sage flex items-center justify-center shrink-0 shadow-md shadow-sage-dark/25">
                        <i data-lucide="mail" class="w-5 h-5 text-white"></i>
                    </div>
                    <p class="font-heading font-bold text-3xl text-slate-800">{{ nouveauxMessages }}</p>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <p class="text-xs md:text-sm text-slate-400 md:truncate">Messages non traités</p>
                    <div class="hidden md:flex items-center gap-1 text-sm font-medium text-sage-dark shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                        Voir tout <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </div>
                </div>
            </div>
        </a>
        <a href="{{ path('admin_clients') }}" class="group relative overflow-hidden bg-white rounded-3xl p-5 hover:shadow-xl hover:shadow-slate-900/5 hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="users" class="absolute -right-3 -top-3 w-24 h-24 text-teal-500/5 group-hover:text-teal-500/10 group-hover:scale-110 transition-all duration-300"></i>
            <div class="relative">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-11 h-11 rounded-xl bg-linear-to-br from-teal-600 to-teal-400 flex items-center justify-center shrink-0 shadow-md shadow-teal-500/25">
                        <i data-lucide="users" class="w-5 h-5 text-white"></i>
                    </div>
                    <p class="font-heading font-bold text-3xl text-slate-800">{{ totalClients }}</p>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <p class="text-xs md:text-sm text-slate-400 md:truncate">Clients</p>
                    <div class="hidden md:flex items-center gap-1 text-sm font-medium text-teal-600 shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                        Voir tout <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </div>
                </div>
            </div>
        </a>
        <a href="{{ path('admin_projects', {statut: 'en_cours'}) }}" class="group relative overflow-hidden bg-white rounded-3xl p-5 hover:shadow-xl hover:shadow-slate-900/5 hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="folder-kanban" class="absolute -right-3 -top-3 w-24 h-24 text-blue-500/5 group-hover:text-blue-500/10 group-hover:scale-110 transition-all duration-300"></i>
            <div class="relative">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-11 h-11 rounded-xl bg-linear-to-br from-blue-600 to-blue-400 flex items-center justify-center shrink-0 shadow-md shadow-blue-500/25">
                        <i data-lucide="folder-kanban" class="w-5 h-5 text-white"></i>
                    </div>
                    <p class="font-heading font-bold text-3xl text-slate-800">{{ projetsEnCours }}</p>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <p class="text-xs md:text-sm text-slate-400 md:truncate">Projets en cours</p>
                    <div class="hidden md:flex items-center gap-1 text-sm font-medium text-blue-600 shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                        Voir tout <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </div>
                </div>
            </div>
        </a>
        <a href="{{ path('admin_interventions', {dateFrom: 'now'|date('Y-m-01'), dateTo: 'now'|date('Y-m-t')}) }}" class="group relative overflow-hidden bg-white rounded-3xl p-5 hover:shadow-xl hover:shadow-slate-900/5 hover:-translate-y-0.5 transition-all duration-200">
            <i data-lucide="wrench" class="absolute -right-3 -top-3 w-24 h-24 text-purple-500/5 group-hover:text-purple-500/10 group-hover:scale-110 transition-all duration-300"></i>
            <div class="relative">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-11 h-11 rounded-xl bg-linear-to-br from-purple-600 to-purple-400 flex items-center justify-center shrink-0 shadow-md shadow-purple-500/25">
                        <i data-lucide="wrench" class="w-5 h-5 text-white"></i>
                    </div>
                    <p class="font-heading font-bold text-3xl text-slate-800">{{ interventionsCeMois }}</p>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <p class="text-xs md:text-sm text-slate-400 md:truncate">Interventions ce mois</p>
                    <div class="hidden md:flex items-center gap-1 text-sm font-medium text-purple-600 shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                        Voir tout <i data-lucide="arrow-right" class="w-3 h-3"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    {# ---------- Derniers messages ---------- #}
    <div class="bg-white rounded-2xl overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-slate-800">Derniers messages</p>
                {% if nouveauxMessages > 0 %}
                    <span class="bg-sage-dark/10 text-sage-dark text-[11px] font-medium px-2 py-0.5 rounded-full">{{ nouveauxMessages }} nouveau{{ nouveauxMessages > 1 ? 'x' : '' }}</span>
                {% endif %}
            </div>
            <a href="{{ path('admin_messages') }}" class="flex items-center gap-1 text-xs text-sage-dark font-medium">
                Voir tout
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
        </div>
        {% for contact in derniersMessages %}
            <a href="{{ path('admin_messages', {open: contact.id}) }}" class="flex items-center gap-3 px-5 py-3 {% if not loop.last %}border-b border-slate-50{% endif %} {{ contact.statut == 'nouveau' ? 'border-l-[3px] border-l-sage-dark' : 'border-l-[3px] border-l-transparent' }} hover:bg-[#faf9f6] transition cursor-pointer">
                <div class="w-8 h-8 shrink-0 rounded-full flex items-center justify-center text-xs font-semibold {{ avatarColors[contact.id % avatarColors|length] }}">
                    {{ contact.nom|slice(0, 1)|upper }}{{ contact.nom|split(' ')|last|slice(0, 1)|upper }}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-slate-800 truncate">{{ contact.nom }}</p>
                    <p class="text-xs text-slate-400">{{ contact.typeBesoin|replace({'_': ' '})|capitalize }} · {{ contact.createdAt|date('d/m à H:i') }}</p>
                </div>
                <span class="shrink-0 flex items-center gap-1.5 text-[10.5px] font-medium px-2.5 py-1 rounded-full
                    {{ contact.statut == 'nouveau' ? 'bg-green-100 text-green-700' : '' }}
                    {{ contact.statut == 'vu' ? 'bg-blue-100 text-blue-700' : '' }}
                    {{ contact.statut == 'en_cours' ? 'bg-amber-100 text-amber-700' : '' }}
                    {{ contact.statut == 'traite' ? 'bg-slate-100 text-slate-500' : '' }}">
                    <span class="w-1.5 h-1.5 rounded-full
                        {{ contact.statut == 'nouveau' ? 'bg-green-500' : '' }}
                        {{ contact.statut == 'vu' ? 'bg-blue-500' : '' }}
                        {{ contact.statut == 'en_cours' ? 'bg-amber-500' : '' }}
                        {{ contact.statut == 'traite' ? 'bg-slate-400' : '' }}"></span>
                    {{ contact.statut|replace({'_': ' '})|capitalize }}
                </span>
            </a>
        {% else %}
            <div class="flex flex-col items-center justify-center py-14 text-center">
                <div class="w-12 h-12 rounded-full bg-[#faf9f6] flex items-center justify-center mb-3">
                    <i data-lucide="mail" class="w-5 h-5 text-slate-300"></i>
                </div>
                <p class="text-sm text-slate-400">Aucun message pour le moment.</p>
            </div>
        {% endfor %}
    </div>

{% endblock %}
