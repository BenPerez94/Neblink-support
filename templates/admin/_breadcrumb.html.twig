{% macro render(items) %}
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 mb-4 flex-wrap" aria-label="Fil d'ariane">
        {% for item in items %}
            {% if not loop.first %}
                <i data-lucide="chevron-right" class="w-3 h-3 text-slate-300 shrink-0"></i>
            {% endif %}
            {% if item.path is defined and item.path and not loop.last %}
                <a href="{{ item.path }}" class="hover:text-sage-dark transition shrink-0">{{ item.label }}</a>
            {% else %}
                <span class="text-slate-600 font-medium truncate">{{ item.label }}</span>
            {% endif %}
        {% endfor %}
    </nav>
{% endmacro %}
