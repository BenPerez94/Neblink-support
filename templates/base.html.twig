<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Neblink">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="https://www.neblink.fr{{ app.request.pathInfo }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/og-image.jpg')) }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Neblink">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        
        
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        
        <title>{% block title %}Neblink — Dépannage & développement web{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Dépannage informatique et création de sites web à Chaumont. Intervention rapide, devis gratuit, sans jargon.{% endblock %}">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600&family=Inter:wght@400;500&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('android-chrome-192x192.png') }}">
        <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('android-chrome-512x512.png') }}">
        <link rel="canonical" href="https://www.neblink.fr{{ app.request.pathInfo }}">

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        
        <!-- {% block nav_light %}false{% endblock %} -->

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                "name": "Neblink",
                "description": "Dépannage informatique et développement web à Chaumont, Neufchâteau et alentours, avec intervention à distance possible partout en France",
                "telephone": "+33744476907",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Rimaucourt",
                    "postalCode": "52700",
                    "addressRegion": "Grand Est",
                    "addressCountry": "FR"
                },
                "areaServed": [
                    {
                        "@type": "Place",
                        "name": "Rimaucourt"
                    },
                    {
                        "@type": "Place",
                        "name": "Chaumont"
                    },
                    {
                        "@type": "Place",
                        "name": "Neufchâteau"
                    },
                    {
                        "@type": "Country",
                        "name": "France"
                    }
                ],
                "openingHours": "Mo-Sat 09:00-20:00",
                "url": "https://www.neblink.fr",
                "image": "https://www.neblink.fr/images/og-image.jpg"
            }
        </script>

        <!-- Cloudflare Web Analytics -->
        <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "c7b3aa8332324849bf4009267bfc6883"}'></script>
        <!-- End Cloudflare Web Analytics -->
    </head>
    {% for message in app.flashes('success') %}
        <div data-flash-type="success" data-flash-message="{{ message }}" class="hidden"></div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div data-flash-type="error" data-flash-message="{{ message }}" class="hidden"></div>
    {% endfor %}
    <body class="font-sans text-slate-800 bg-[#faf9f6]">
        
        {# ---------- NAVBAR ---------- #}
        <header id="site-header" class="sticky top-0 z-50 px-4 py-4 {% block header_bg %}bg-transparent{% endblock %}">
            <nav id="site-nav" class="relative max-w-3xl mx-auto flex items-center justify-between {{ (block('nav_light') is defined and block('nav_light') == 'true') ? 'bg-white/70 border-slate-900/10 shadow-lg shadow-slate-900/5' : 'bg-white/15 border-white/30' }} backdrop-blur-md border rounded-2xl px-4 py-2.5">

                    <a href="{{ path('app_home') }}" class="flex items-center gap-2">
                        <div id="nav-logo-box" class="w-7 h-7 rounded-lg flex items-center justify-center font-heading font-semibold text-sm {{ block('nav_light') == 'true' ? 'bg-sage-dark text-white' : 'bg-white text-sage-dark' }}">N</div>
                        <span id="nav-logo-text" class="font-heading font-medium text-sm {{ block('nav_light') == 'true' ? 'text-slate-800' : 'text-white' }}">Neblink</span>
                    </a>

                    <div class="hidden md:flex items-center gap-6">
                        <a href="{{ path('app_home') }}" class="nav-link text-sm transition {{ block('nav_light') == 'true' ? 'text-slate-600 hover:text-slate-900' : 'text-white/80 hover:text-white' }} {{ app.request.attributes.get('_route') == 'app_home' ? 'font-medium border-b border-current pb-0.5' }}">Dépannage</a>
                        <a href="{{ path('app_dev_web') }}" class="nav-link text-sm transition {{ block('nav_light') == 'true' ? 'text-slate-600 hover:text-slate-900' : 'text-white/80 hover:text-white' }} {{ app.request.attributes.get('_route') == 'app_dev_web' ? 'font-medium border-b border-current pb-0.5' }}">Développement web</a>
                        <a href="{{ path('app_about') }}" class="nav-link text-sm transition {{ block('nav_light') == 'true' ? 'text-slate-600 hover:text-slate-900' : 'text-white/80 hover:text-white' }} {{ app.request.attributes.get('_route') == 'app_about' ? 'font-medium border-b border-current pb-0.5' }}">À propos</a>
                    </div>

                    <a href="{{ path('app_contact') }}" id="nav-contact-btn" class="hidden md:inline-flex {{ block('nav_light') == 'true' ? 'bg-sage-dark text-white' : 'bg-white text-sage-dark' }} rounded-lg px-4 py-2 text-sm font-medium font-heading">
                        Contact
                    </a>

                    <button id="burger-btn" class="md:hidden {{ block('nav_light') == 'true' ? 'text-slate-800' : 'text-white' }} p-1" aria-label="Ouvrir le menu" aria-expanded="false">
        
                    <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>

                {# Panneau mobile #}
                <div id="mobile-panel" class="md:hidden absolute top-full left-0 right-0 mt-2 opacity-0 -translate-y-2 pointer-events-none transition-all duration-200">
                    <div class="bg-sage-dark/95 backdrop-blur-md border border-white/30 rounded-2xl p-4 flex flex-col gap-1 shadow-xl">
                        <a href="{{ path('app_home') }}" class="py-2.5 px-2 text-sm text-white border-b border-white/20">Dépannage</a>
                        <a href="{{ path('app_dev_web') }}" class="py-2.5 px-2 text-sm text-white/85 border-b border-white/20">Développement web</a>
                        <a href="{{ path('app_about') }}" class="py-2.5 px-2 text-sm text-white/85 border-b border-white/20">À propos</a>
                        <a href="{{ path('app_contact') }}" class="mt-2 bg-white text-sage-dark text-center rounded-lg py-2.5 text-sm font-medium font-heading">Contact</a>
                    </div>
                </div>
            </nav>
        </header>

        {# ---------- CONTENU DE LA PAGE ---------- #}
        <main class="flow-root">
            {% block body %}{% endblock %}
        </main>

        {# ---------- FOOTER ---------- #}
        {% block footer %}
        <footer class="max-w-3xl mx-auto px-4 pb-8 pt-3 mt-8 border-t border-slate-200">
            <div class="flex flex-col md:flex-row justify-center md:justify-between items-center gap-2 md:gap-4 mb-3">
                <a href="{{ path('espace_client_login') }}" class="text-xs text-slate-400 hover:text-sage-dark">Espace client</a>
                <div class="flex gap-4">
                    <a href="{{ path('app_mentions_legales') }}" class="text-xs text-slate-400 hover:text-sage-dark">Mentions légales</a>
                    <a href="{{ path('app_confidentialite') }}" class="text-xs text-slate-400 hover:text-sage-dark">Confidentialité</a>
                </div>
            </div>
            <div class="flex flex-col md:flex-row items-center md:justify-between gap-3 text-center md:text-left">
                <p class="text-xs text-slate-400">© {{ "now"|date("Y") }} Neblink — Chaumont, Neufchâteau et alentours</p>
                <div class="flex gap-4">
                    <a href="{{ path('app_home') }}" class="text-xs text-slate-500 hover:text-sage-dark">Dépannage</a>
                    <a href="{{ path('app_dev_web') }}" class="text-xs text-slate-500 hover:text-sage-dark">Développement web</a>
                    <a href="{{ path('app_contact') }}" class="text-xs text-slate-500 hover:text-sage-dark">Contact</a>
                </div>
            </div>
            
        </footer>
        {% endblock %}
    </body>
</html>
